---
/**
 * Les déclarations d'un élu à la HATVP : leur statut, et le contenu de la
 * dernière déclaration d'intérêts publiée, tel quel. Voir
 * `scripts/declarations-emettre.ts`. Jamais une déclaration de patrimoine.
 */
import type { DeclarationElu } from '../modele/elus-echelons.ts';

interface Props {
  d: DeclarationElu;
}
const { d } = Astro.props;
const jour = (iso: string) => new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
/** Les sigles que la HATVP donne elle-même à ses types de document (`di`, `dim`, `dia`, `diam`). */
const SIGLES: Record<string, string> = {
  'déclaration d’intérêts': 'DI',
  'modification de la déclaration d’intérêts': 'DIM',
  'déclaration d’intérêts et d’activités': 'DIA',
  'modification de la déclaration d’intérêts et d’activités': 'DIAM',
};
// Les lignes arrivent rangées par rubrique : on ne nomme la rubrique qu'une
// fois, au lieu de la répéter à chaque ligne — « Organe dirigeant » revenait
// deux cents fois sur la page d'un département.
const rubriques: { nom: string; lignes: NonNullable<typeof d.contenu>['lignes'] }[] = [];
for (const l of d.contenu?.lignes ?? []) {
  const der = rubriques.at(-1);
  if (der && der.nom === l.rubrique) der.lignes.push(l);
  else rubriques.push({ nom: l.rubrique, lignes: [l] });
}
---
<span class="p-adjoint-naissance">
  {d.page ? <a href={d.page} target="_blank" rel="noopener">HATVP</a> : 'HATVP'}
  {' : '}
  {d.liste.map((x, i) => (
    <>
      {i > 0 && ' ; '}
      {SIGLES[x.type] ? <abbr title={x.type}>{SIGLES[x.type]}</abbr> : x.type}
      {`, ${x.statut.toLowerCase()}${x.date ? `, ${jour(x.date)}` : ''}`}
    </>
  ))}
</span>
{d.contenu && d.contenu.lignes.length > 0 && (
  <details class="p-declaration-contenu">
    <summary>
      {`Sa dernière déclaration d’intérêts publiée — déposée le ${jour(d.contenu.depot)}` + (d.contenu.qualite ? `, comme ${d.contenu.qualite}` : '')}
    </summary>
    {rubriques.map((r) => (
      <>
        <p class="p-declaration-rubrique">{r.lignes.length > 1 ? `${r.nom} (${r.lignes.length})` : r.nom}</p>
        <ul>
          {r.lignes.map((l) => (
            <li>
              <span>{[l.intitule, l.precision].filter(Boolean).join(' — ')}</span>
              <span class="p-adjoint-naissance">{[l.periode, l.montant].filter(Boolean).join(' · ')}</span>
              {l.commentaire && <span class="p-adjoint-naissance p-declaration-commentaire">{`« ${l.commentaire} »`}</span>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </details>
)}
