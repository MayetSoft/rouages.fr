---
/**
 * Le bloc de partage d'un défi du jour : l'aperçu du texte, puis les
 * boutons — le partage du téléphone et la copie en toutes lettres, chaque
 * réseau par son logo, dans sa couleur, avec son nom pour qui ne voit pas
 * l'image. `brancherPartage` (`src/client/jeux-commun.ts`) le remplit et le
 * branche ; les identifiants sont préfixés pour que chaque jeu garde les siens.
 */
import { ICONES, type Reseau } from './icones-partage.ts';

interface Props {
  id: string;
}
const { id } = Astro.props;
/** Les réseaux qui prennent un lien ; Instagram, qui n'en prend pas, reçoit une image. */
const LIENS: Reseau[] = ['whatsapp', 'facebook', 'x', 'bluesky', 'linkedin'];
---
<div id={`${id}-partage`} class="pj" hidden>
  <p class="pj-titre">Partager le défi du jour — le résultat seulement</p>
  <pre id={`${id}-apercu`} class="pj-apercu"></pre>
  <div class="pj-boutons">
    <button class="bouton pj-bouton" type="button" id={`${id}-natif`} hidden>Partager</button>
    <button class="plat" type="button" id={`${id}-copier`}>Copier</button>
    <span class="pj-reseaux">
      {LIENS.map((r) => (
        <a class="pj-reseau" id={`${id}-${r}`} target="_blank" rel="noopener" title={`Partager sur ${ICONES[r].nom}`} aria-label={`Partager sur ${ICONES[r].nom}`} style={`--marque:${ICONES[r].couleur}`} data-reseau={r}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICONES[r].d} /></svg>
        </a>
      ))}
      <button class="pj-reseau" type="button" id={`${id}-instagram`} title="Partager sur Instagram : une image du résultat" aria-label="Partager sur Instagram : une image du résultat" style={`--marque:${ICONES.instagram.couleur}`} data-reseau="instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICONES.instagram.d} /></svg>
      </button>
    </span>
  </div>
  <p id={`${id}-note-image`} class="pj-titre pj-note" hidden aria-live="polite"></p>
</div>

<style>
  .pj { border-top: 1px solid var(--trait); margin: 1rem 0; padding-top: .8rem; }
  .pj [hidden], .pj[hidden] { display: none; }
  .pj-titre { color: var(--encre-douce); font-size: .85rem; margin: 0 0 .4rem; }
  .pj-note { margin: .6rem 0 0; }
  .pj-apercu {
    white-space: pre-wrap; word-break: break-word; font: inherit; font-size: .92rem;
    background: var(--fond-doux); border-radius: var(--rayon); padding: .6rem .8rem; margin: 0 0 .7rem;
  }
  .pj-boutons { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .pj-bouton { border: 0; cursor: pointer; font: inherit; }
  .pj-reseaux { display: flex; flex-wrap: wrap; gap: .45rem; }
  .pj-reseau {
    display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; padding: 0; cursor: pointer;
    border: 0; border-radius: 50%; background: var(--marque); color: #fff;
    transition: transform var(--transition), filter var(--transition);
  }
  .pj-reseau:hover, .pj-reseau:focus-visible { filter: brightness(1.1); transform: translateY(-1px); }
  .pj-reseau:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pj-reseau svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }
  /* Le logo de X est noir sur blanc ou blanc sur noir : on suit le thème. */
  .pj-reseau[data-reseau="x"] { background: var(--encre); color: var(--fond); }
</style>
