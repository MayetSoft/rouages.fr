---
/**
 * Trouver une commune depuis n'importe quelle page.
 *
 * La page d'une commune est l'endroit où le site dit tout ce qu'il en sait ;
 * il fallait pouvoir y arriver d'ailleurs que par la carte. Sans JavaScript, le
 * lien mène aux « Données de chez moi », qui listent régions, départements et
 * communes ; avec, il devient un champ qui y conduit directement. L'index
 * national n'est téléchargé qu'à la première frappe.
 */
---
<div class="entete-commune">
  <a class="entete-communes" href="/chez-moi">Trouver une commune</a>
  <div class="entete-recherche" hidden>
    <label class="visuellement-cache" for="entete-commune-champ">Une commune, ou son code postal</label>
    <input
      id="entete-commune-champ"
      type="search"
      placeholder="Une commune, un code postal…"
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="entete-commune-liste"
    />
    <ul id="entete-commune-liste" role="listbox" aria-label="Communes trouvées"></ul>
  </div>
</div>
<script>
  import { brancherRechercheCommune } from '../client/entete.ts';
  brancherRechercheCommune();
</script>
