---
/**
 * Une ligne de repère chiffré : le nom, le montant, sa réglette, sa médiane,
 * et sur une seconde ligne la série et ce qu'elle a changé.
 *
 * La même forme sert aux comptes de la commune, à ceux des échelons, aux flux
 * perçus par l'intercommunalité, au scrutin, au conseil, aux habitants et aux
 * associations. C'était une douzaine de copies dans le panneau.
 */
import { reglette, tendance } from '../../vues/graphiques.ts';
import EcartMediane from './EcartMediane.astro';

interface Props {
  nom: string;
  /** L'explication du repère, en infobulle sur son nom. */
  aide?: string;
  montant: string;
  /** La réglette, quand il y a une médiane à laquelle se rapporter. */
  compare?: { valeur: number; mediane: number; reference?: string } | null;
  mediane?: string | null;
  serie?: { valeurs: (number | null)[]; annees: number[]; formater?: (v: number) => string } | null;
  evolution?: string | null;
  detail?: string | null;
  /** L'identifiant du repère des comptes, pour dire l'écart à la médiane — voir `modele/ecart-mediane.ts`. */
  repere?: string;
}
const { nom, aide, montant, compare, mediane, serie, evolution, detail, repere } = Astro.props;
const svgReglette = compare && compare.mediane > 0 ? reglette(compare.valeur, compare.mediane, compare.reference) : null;
const svgCourbe = serie ? tendance(serie.valeurs, serie.annees, serie.formater) : null;
---
<div>
  <dt title={aide || undefined}>{nom}<slot name="sous-nom" /></dt>
  <dd>
    <span class="p-montant">{montant}</span>
    {svgReglette && <Fragment set:html={svgReglette} />}
    {mediane && <span class="p-mediane">{mediane}</span>}
    {repere && compare && <EcartMediane id={repere} valeur={compare.valeur} mediane={compare.mediane} />}
    {detail && <span class="p-scrutin-detail">{detail}</span>}
    {svgCourbe && (
      <span class="p-tendance-ligne">
        <Fragment set:html={svgCourbe} />
        {evolution && <span class="p-evolution">{evolution}</span>}
      </span>
    )}
  </dd>
</div>
