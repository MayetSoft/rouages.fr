---
/**
 * Ce que la commune et ses groupements commandent, et ce qui arrive à échéance.
 *
 * L'échéancier vient d'abord : c'est ce qui se décidera bientôt, toutes
 * structures confondues, du plus proche au plus lointain. Chaque acheteur porte
 * ses douze échéances les plus proches, et la page en montre douze au plus :
 * celles-ci sont donc exactes, même quand un seul acheteur les fournit toutes.
 *
 * La commune est ouverte, ses groupements repliés : six acheteurs à cinq
 * marchés font trente lignes, et le décompte reste visible sur chaque en-tête.
 * Les cinq plus récents sont écrits dans la page ; la suite a son propre
 * fichier, que le bouton va chercher — sans JavaScript, le bouton n'apparaît
 * pas, et le décompte dit ce qu'il reste.
 */
import type { AcheteurMarches } from '../../modele/fiche-commune.ts';
import Glose from '../Glose.astro';
import { moisAnnee, montantCourt } from '../../vues/graphiques.ts';

interface Props {
  liste: AcheteurMarches[];
  depuis: string | null;
  /** Premier et dernier mois de la fenêtre des échéances (AAAA-MM). */
  fenetre: [string, string] | null;
  procedures: string[];
}
const { liste, depuis, fenetre, procedures } = Astro.props;
/** La fiche publique d'une entreprise, sur l'annuaire de l'État. */
const FICHE = 'https://annuaire-entreprises.data.gouv.fr/entreprise/';
const autres = (m: AcheteurMarches['liste'][number]) =>
  m.autresTitulaires > 0
    ? `${m.titulaires.length > 0 ? 'et ' : ''}${m.autresTitulaires} titulaire${m.autresTitulaires > 1 ? 's' : ''} non nommé${m.autresTitulaires > 1 ? 's' : ''}`
    : '';
const offres = (n: number | null) => (n === null ? [] : [`${n} offre${n > 1 ? 's' : ''} reçue${n > 1 ? 's' : ''}`]);
const detail = (m: AcheteurMarches['liste'][number]) =>
  [moisAnnee(m.date) ?? m.date, ...(m.procedure ? [m.procedure.toLowerCase()] : []), ...(m.lots > 1 ? [`${m.lots} lots`] : []), ...offres(m.offres)].join(' · ');

// Le quinze du mois : `new Date('2027-03')` est minuit UTC le 1er mars, qui
// s'affiche « février » partout à l'ouest de Greenwich.
const mois = (aaaamm: string) => moisAnnee(`${aaaamm}-15`) ?? aaaamm;
const AFFICHEES = 12;
const echeances = liste
  .flatMap((a) => a.echeances)
  .sort((a, b) => a.fin.localeCompare(b.fin) || (b.montant ?? 0) - (a.montant ?? 0));
const totalEcheances = liste.reduce((t, a) => t + a.totalEcheances, 0);
const plusieursAcheteurs = liste.length > 1;
const detailEcheance = (m: (typeof echeances)[number]) =>
  [
    ...(plusieursAcheteurs ? [m.acheteur] : []),
    `notifié en ${moisAnnee(m.date) ?? m.date}`,
    ...(m.procedure ? [m.procedure.toLowerCase()] : []),
    ...offres(m.offres),
  ].join(' · ');
---
{fenetre && echeances.length > 0 && (
  <div class="p-marche-acheteur p-echeances">
    <p class="p-marche-qui">
      <span class="p-marche-nom">{`À renouveler d’ici ${mois(fenetre[1])}`}</span>
      <span class="p-marche-total">
        {`${totalEcheances.toLocaleString('fr-FR')} marché${totalEcheances > 1 ? 's' : ''}` +
          (totalEcheances > AFFICHEES ? `, les ${AFFICHEES} plus proches` : '')}
      </span>
    </p>
    <p class="p-strate">
      {'Les accords-cadres et les marchés de services récurrents d’au moins un an — ' +
        'entretien, restauration, transport, assurance, nettoyage, collecte : ceux qui se ' +
        'repassent à leur terme. Un chantier, un achat ponctuel ou une étude s’achèvent, ils ne ' +
        'se relancent pas. L’échéance est prévisible : la date de notification plus la durée initiale ' +
        'déclarée. Un avenant ou une reconduction la déplace, et le recensement national ne ' +
        'publie pas ces modifications de durée. Le tri suit ce que l’acheteur a déclaré : une ' +
        'étude ou un chantier déclarés en accord-cadre y figurent. '}
      <a href="/territoires/echeances.json">{'Toutes les échéances du pays, en un fichier'}</a>
      {' — avec l’acheteur, son département, le code CPV et le titulaire.'}
    </p>
    <ul>
      {echeances.slice(0, AFFICHEES).map((m) => (
        <li>
          <span class="p-echeance-mois">{mois(m.fin)}</span>
          <span>
            <span class="p-marche-objet">{m.objet}</span>
            <span class="p-marche-detail">{`${montantCourt(m.montant)} · ${detailEcheance(m)}`}</span>
            {m.titulaires.length > 0 && (
              <span class="p-marche-detail p-marche-titulaires">
                {'titulaire : '}
                {m.titulaires.map((t, i) => (
                  <>{i > 0 && ', '}<a href={FICHE + t.siren} target="_blank" rel="noopener">{t.nom}</a></>
                ))}
                {autres(m) && ` ${autres(m)}`}
              </span>
            )}
          </span>
        </li>
      ))}
    </ul>
  </div>
)}
<p class="p-strate">
  {`Marchés notifiés depuis ${(depuis ?? '').slice(0, 4)}, du plus récent au plus ancien. Les ` +
    'montants ne s’additionnent pas : un accord-cadre déclare un plafond, et chacun de ses lots ' +
    'le redéclare en entier. Un même marché peut aussi figurer deux fois, publié sous deux ' +
    'libellés — le recensement n’est pas dédoublonné à la source.'}
</p>
{liste.map((a, rang) => {
  const Groupe = rang > 0 ? 'details' : 'div';
  const Titre = rang > 0 ? 'summary' : 'p';
  return (
    <Groupe class="p-marche-acheteur">
      <Titre class="p-marche-qui">
        <span class="p-marche-nom"><Glose texte={a.nom} /></span>
        {a.natureLibelle && <span class="p-marche-nature">{a.natureLibelle}</span>}
        <span class="p-marche-total">
          {`${a.total.toLocaleString('fr-FR')} marché${a.total > 1 ? 's' : ''}` +
            (a.total > a.liste.length ? `, les ${a.liste.length} plus récents` : '')}
        </span>
      </Titre>
      <ul>
        {a.liste.map((m) => (
          <li>
            <span class="p-marche-montant">{montantCourt(m.montant)}</span>
            <span>
              <span class="p-marche-objet">{m.objet}</span>
              <span class="p-marche-detail">{detail(m)}</span>
              {(m.titulaires.length > 0 || m.autresTitulaires > 0) && (
                <span class="p-marche-detail p-marche-titulaires">
                  {'titulaire : '}
                  {m.titulaires.map((t, i) => (
                    <>{i > 0 && ', '}<a href={FICHE + t.siren} target="_blank" rel="noopener">{t.nom}</a></>
                  ))}
                  {autres(m) && `${m.titulaires.length > 0 ? ' ' : ''}${autres(m)}`}
                </span>
              )}
            </span>
          </li>
        ))}
      </ul>
      {a.total > a.liste.length && (
        <button
          type="button"
          class="p-marche-suite"
          hidden
          data-siren={a.siren}
          data-total={a.total}
          data-affiches={a.liste.length}
        >{`Voir les ${(a.total - a.liste.length).toLocaleString('fr-FR')} autres`}</button>
      )}
      {a.siret && (
        <p class="p-marche-ailleurs">
          <a href={`https://colibre.fr/acheteurs/${a.siret}`}>{'Tous ses marchés, avec les titulaires, sur Colibre'}</a>
        </p>
      )}
    </Groupe>
  );
})}
<p class="p-source-territoire">
  {'D’après les données essentielles de la commande publique, publiées par le ministère de l’Économie. ' +
    'Le titulaire y figure par son SIRET ; son nom vient du répertoire SIRENE, et chaque nom mène à sa ' +
    'fiche sur l’annuaire des entreprises de l’État. Une société est nommée par sa dénomination, un ' +
    'entrepreneur individuel seulement si le répertoire le dit diffusible ; un titulaire hors de France ou ' +
    'inconnu du répertoire est compté, pas nommé. Une demande de retrait s’adresse à l’éditeur (voir « Signaler »).'}
</p>
<script is:inline type="application/json" id="marches-procedures" set:html={JSON.stringify(procedures).replace(/</g, "\\u003c")} />
<script>
  /**
   * « Voir les 403 autres ». Le premier clic va chercher le fichier de
   * l'acheteur, une fois ; les suivants n'ajoutent que vingt-cinq lignes, parce
   * qu'une liste de cinq mille marchés dépliée d'un coup ne se lit pas et fige
   * la page sur un téléphone.
   */
  const PAS = 25;
  const procedures: string[] = JSON.parse(document.getElementById('marches-procedures')?.textContent ?? '[]');
  const moisAnnee = (iso: string) => {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? null : d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
  };
  const montantCourt = (v: number | null) => {
    if (v === null) return '—';
    if (Math.abs(v) >= 1_000_000) return `${(v / 1_000_000).toLocaleString('fr-FR', { maximumFractionDigits: 1 })} M€`;
    if (Math.abs(v) >= 1_000) return `${Math.round(v / 1000).toLocaleString('fr-FR')} k€`;
    return `${Math.round(v).toLocaleString('fr-FR')} €`;
  };
  type Brut = {
    objet: string;
    montant: number | null;
    date: string;
    procedure: number;
    lots: number;
    offres?: number;
    t?: [string, string][];
    tx?: number;
  };
  const span = (classe: string, texte: string) => {
    const s = document.createElement('span');
    s.className = classe;
    s.textContent = texte;
    return s;
  };
  const ligne = (m: Brut) => {
    const li = document.createElement('li');
    const droite = document.createElement('span');
    const sous = [moisAnnee(m.date) ?? m.date];
    const proc = procedures[m.procedure];
    if (proc) sous.push(proc.toLowerCase());
    if (m.lots > 1) sous.push(`${m.lots} lots`);
    if (m.offres) sous.push(`${m.offres} offre${m.offres > 1 ? 's' : ''} reçue${m.offres > 1 ? 's' : ''}`);
    droite.append(span('p-marche-objet', m.objet), span('p-marche-detail', sous.join(' · ')));
    if ((m.t ?? []).length > 0 || m.tx) {
      const t = span('p-marche-detail p-marche-titulaires', 'titulaire : ');
      (m.t ?? []).forEach(([siren, nom], i) => {
        if (i > 0) t.append(', ');
        const a = document.createElement('a');
        a.href = `https://annuaire-entreprises.data.gouv.fr/entreprise/${siren}`;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = nom;
        t.append(a);
      });
      if (m.tx) t.append(`${(m.t ?? []).length > 0 ? ' et ' : ''}${m.tx} titulaire${m.tx > 1 ? 's' : ''} non nommé${m.tx > 1 ? 's' : ''}`);
      droite.append(t);
    }
    li.append(span('p-marche-montant', montantCourt(m.montant)), droite);
    return li;
  };

  for (const bouton of document.querySelectorAll<HTMLButtonElement>('button.p-marche-suite[data-siren]')) {
    const ul = bouton.previousElementSibling as HTMLUListElement;
    const siren = bouton.dataset.siren!;
    const total = Number(bouton.dataset.total);
    let affiches = Number(bouton.dataset.affiches);
    const deja = affiches;
    let reste: Brut[] | null = null;
    let echec: HTMLElement | null = null;
    // Avant le chargement, le décompte du recensement ; après, le nombre exact
    // de lignes — un accord-cadre publie une ligne par lot, que le site regroupe.
    const direRestant = () => {
      const fin = reste ? deja + reste.length : total;
      bouton.textContent = `Voir les ${(fin - affiches).toLocaleString('fr-FR')} autres`;
    };
    bouton.hidden = false;
    bouton.addEventListener('click', async () => {
      if (!reste) {
        bouton.disabled = true;
        bouton.textContent = 'Chargement…';
        const f = await fetch(`/territoires/marches/${siren}.json`)
          .then((r) => (r.ok ? (r.json() as Promise<{ m: Brut[] }>) : null))
          .catch(() => null);
        bouton.disabled = false;
        // Aucun fichier n'est écrit vide : une liste vide vient d'une requête
        // qui a échoué, et le bouton reste pour le clic suivant.
        if (!f || f.m.length === 0) {
          if (!echec) {
            echec = span('p-marche-detail', 'La suite ne s’est pas chargée. À réessayer.');
            bouton.after(echec);
          }
          direRestant();
          return;
        }
        echec?.remove();
        echec = null;
        reste = f.m;
      }
      const lot = reste.slice(affiches - deja, affiches - deja + PAS);
      for (const m of lot) ul.append(ligne(m));
      affiches += lot.length;
      if (affiches >= deja + reste.length) bouton.remove();
      else direRestant();
    });
  }
</script>
