---
/**
 * « Titulaire : X, Y et 2 autres », chaque nom lié à sa fiche de l'annuaire des
 * entreprises de l'État — la fiche d'origine que la règle des noms exige.
 *
 * Le même rendu existe en JavaScript dans `Marches.astro`, pour la suite des
 * listes chargée à la demande : les deux doivent rester d'accord.
 */
interface Props {
  titulaires: { siren: string; nom: string }[];
  autres: number;
}
const { titulaires, autres } = Astro.props;
const total = titulaires.length + autres;
---
{titulaires.length > 0 && (
  <span class="p-marche-titulaire">
    {total > 1 ? 'Titulaires : ' : 'Titulaire : '}
    {titulaires.map((t, i) => (
      <>{i > 0 && (i === titulaires.length - 1 && autres === 0 ? ' et ' : ', ')}<a href={`https://annuaire-entreprises.data.gouv.fr/entreprise/${t.siren}`}>{t.nom}</a></>
    ))}
    {autres > 0 && ` et ${autres} autre${autres > 1 ? 's' : ''}`}
  </span>
)}
