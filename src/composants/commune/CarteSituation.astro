---
/**
 * Où est la commune : ses contours, ses voisines — chacune un lien vers sa
 * page —, et, en encart, sa place dans le département. Voir
 * `src/modele/carte.ts` et `scripts/contours-emettre.ts`.
 *
 * Le dessin est fait au build, en SVG dans la page : pas de fond de carte,
 * pas de requête au navigateur, et les couleurs suivent le thème.
 */
import type { Anneau, CarteSituation, Point } from '../../modele/carte.ts';

interface Props {
  carte: CarteSituation;
  nom: string;
  depNom: string;
}
const { carte, nom, depNom } = Astro.props;

const W = 480;
const H = 330;

/** Une projection équirectangulaire à la latitude moyenne : juste à l'échelle d'un département. */
function projection(anneaux: Anneau[]) {
  const ys = anneaux.flat().map(([, y]) => y);
  const lat = (Math.min(...ys) + Math.max(...ys)) / 2 / 1e4;
  const k = Math.cos((lat * Math.PI) / 180);
  return ([x, y]: Point): Point => [x * k, -y];
}
function cadre(points: Point[]) {
  const xs = points.map(([x]) => x);
  const ys = points.map(([, y]) => y);
  return { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys), y1: Math.max(...ys) };
}
const chemin = (anneaux: Point[][]) =>
  anneaux.map((r) => 'M' + r.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L') + 'Z').join('');

// La vue : la commune, et une marge d'un peu moins de sa taille autour, au format du cadre.
const proj = projection(carte.commune);
const ici = carte.commune.map((r) => r.map(proj));
const b = cadre(ici.flat());
const marge = 0.42 * Math.max(b.x1 - b.x0, b.y1 - b.y0);
let { x0, x1, y0, y1 } = { x0: b.x0 - marge, x1: b.x1 + marge, y0: b.y0 - marge, y1: b.y1 + marge };
if ((x1 - x0) / (y1 - y0) < W / H) {
  const l = ((y1 - y0) * W) / H;
  const c = (x0 + x1) / 2;
  [x0, x1] = [c - l / 2, c + l / 2];
} else {
  const h = ((x1 - x0) * H) / W;
  const c = (y0 + y1) / 2;
  [y0, y1] = [c - h / 2, c + h / 2];
}
const echelle = W / (x1 - x0);
const versVue = ([x, y]: Point): Point => [(x - x0) * echelle, (y - y0) * echelle];
const dedans = ([x, y]: Point) => x >= 0 && x <= W && y >= 0 && y <= H;
/** Le point moyen de ce qui est visible d'un contour : là où poser son nom. */
function ancre(anneaux: Point[][]): Point | null {
  const vus = anneaux.flat().filter(dedans);
  if (vus.length < 3) return null;
  const x = vus.reduce((s, p) => s + p[0], 0) / vus.length;
  const y = vus.reduce((s, p) => s + p[1], 0) / vus.length;
  return [Math.min(Math.max(x, 40), W - 40), Math.min(Math.max(y, 12), H - 8)];
}

// L'encart couvre le coin haut droit : un nom qui tomberait dessous passe juste en dessous.
const ENCART = 0.25 * W;
function horsEncart(p: Point | null, texte: string): Point | null {
  if (!p) return null;
  const demiLargeur = texte.length * 3.2;
  return p[0] + demiLargeur > W - ENCART && p[1] < ENCART + 8 ? [p[0], ENCART + 18] : p;
}

const formeIci = ici.map((r) => r.map(versVue));
const voisines = carte.voisines.map((v) => {
  const anneaux = v.anneaux.map((r) => r.map(proj).map(versVue));
  return { ...v, d: chemin(anneaux), ancre: horsEncart(ancre(anneaux), v.nom) };
});
const ancreIci = horsEncart(ancre(formeIci), nom) ?? [W / 2, H / 2];

// L'encart : la silhouette du département, la commune dedans.
const E = 104;
const encart = (() => {
  if (carte.departement.length === 0) return null;
  const p = projection(carte.departement);
  const dep = carte.departement.map((r) => r.map(p));
  const c = cadre(dep.flat());
  const s = (E - 8) / Math.max(c.x1 - c.x0, c.y1 - c.y0);
  const ox = (E - (c.x1 - c.x0) * s) / 2;
  const oy = (E - (c.y1 - c.y0) * s) / 2;
  const v = ([x, y]: Point): Point => [(x - c.x0) * s + ox, (y - c.y0) * s + oy];
  const commune = carte.commune.map((r) => r.map(p).map(v));
  const cc = cadre(commune.flat());
  return {
    dep: chemin(dep.map((r) => r.map(v))),
    commune: chemin(commune),
    point: [(cc.x0 + cc.x1) / 2, (cc.y0 + cc.y1) / 2] as Point,
  };
})();

const n = voisines.length;
const resume =
  `${nom} et ${n === 0 ? 'aucune commune voisine' : n === 1 ? 'sa commune voisine' : `ses ${n} communes voisines`}` +
  (n > 0 ? ` : ${voisines.map((v) => v.nom).join(', ')}` : '') +
  `. En encart, sa place dans le département : ${depNom}.`;
---
<figure class="situation">
  <div class="situation-cadre">
    <svg class="situation-carte" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={resume}>
      {voisines.map((v) => (
        <a href={`/commune/${v.code}`} class="situation-voisine">
          <title>{v.nom}</title>
          <path d={v.d} />
        </a>
      ))}
      <path class="situation-ici" d={chemin(formeIci)} />
      {voisines.map((v) => v.ancre && (
        <text class="situation-nom-voisine" x={v.ancre[0].toFixed(0)} y={v.ancre[1].toFixed(0)} text-anchor="middle" aria-hidden="true">{v.nom}</text>
      ))}
      <text class="situation-nom" x={ancreIci[0].toFixed(0)} y={ancreIci[1].toFixed(0)} text-anchor="middle" aria-hidden="true">{nom}</text>
    </svg>
    {encart && (
      <svg class="situation-encart" viewBox={`0 0 ${E} ${E}`} aria-hidden="true">
        <path class="situation-encart-dep" d={encart.dep} />
        <path class="situation-encart-ici" d={encart.commune} />
        <circle class="situation-encart-point" cx={encart.point[0].toFixed(1)} cy={encart.point[1].toFixed(1)} r="4" />
      </svg>
    )}
  </div>
  {n > 0 && (
    <figcaption class="c-demarches">
      <span class="c-demarches-titre">{n > 1 ? 'Les communes voisines' : 'La commune voisine'}</span>
      {voisines.map((v, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/commune/${v.code}`}>{v.nom}</a>
        </>
      ))}
    </figcaption>
  )}
</figure>
<p class="p-source-territoire">
  {`D’après les contours des communes d’ADMIN EXPRESS de l’IGN, au 1er janvier ${carte.millesime}, simplifiés à 100 mètres par Etalab : deux communes sont voisines quand elles partagent une limite.`}
</p>
