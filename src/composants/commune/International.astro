---
/**
 * Ce qui s'applique ici depuis l'international : le bout local des
 * engagements que la colonne « International » du réseau décrit.
 *
 * - le plan climat-air-énergie de l'intercommunalité — l'accord de Paris,
 *   décliné par la stratégie nationale bas-carbone, que le plan doit prendre
 *   en compte (registre Territoires & Climat de l'ADEME, `scripts/pcaet-emettre.ts`) ;
 * - les désignations internationales qui touchent la commune — site Ramsar,
 *   réserve de biosphère —, d'après les périmètres de l'INPN
 *   (`scripts/espaces-emettre.ts`) ;
 * - les biens du patrimoine mondial, d'après la liste de l'UNESCO et les
 *   périmètres régionaux (`scripts/patrimoine-mondial-emettre.ts`) : la
 *   commune est dans le bien, dans sa zone tampon, ou l'UNESCO y situe un
 *   élément. Les sept biens que porte aussi l'INPN n'y sont pas répétés.
 *
 * Une absence du registre de l'ADEME ne dit pas qu'un plan manque : elle dit
 * que le registre n'en porte pas.
 */
import type { DemarchePcaet } from '../../modele/pcaet.ts';
import { cadrerSurCommune, type Anneau, type ZoneNaturelle } from '../../modele/carte.ts';
import { lienUnesco, type BienMondial, type RattachementMondial } from '../../modele/patrimoine-mondial.ts';

interface Props {
  nom: string;
  epci: { siren: string; nom: string } | null;
  plan: DemarchePcaet | null;
  majPlans: string | null;
  designations: ZoneNaturelle[];
  biens: (BienMondial & { id: number; mode: RattachementMondial[1]; elements: string[] })[];
  majMondial: string | null;
  carte: { commune: Anneau[]; traces: { id: number; zone: 'bien' | 'tampon'; anneaux: Anneau[] }[] } | null;
}
const { nom, epci, plan, majPlans, designations, biens, majMondial, carte } = Astro.props;
// La carte : la commune, le bien et sa zone tampon, découpés à ses limites.
const W = 480;
const H = 300;
const dessin = carte
  ? (() => {
      const vue = cadrerSurCommune(carte.commune, W, H);
      const nomBien = (id: number) => biens.find((b) => b.id === id)?.nom ?? '';
      return {
        commune: vue(carte.commune),
        traces: carte.traces.map((t) => ({ zone: t.zone, nom: nomBien(t.id), d: vue(t.anneaux) })),
      };
    })()
  : null;
const idCarte = `mondial-${Math.abs([...nom].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const plier = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');
// Un bien que l'INPN porte aussi (le Mont-Saint-Michel, la Chaîne des Puys…) n'est dit qu'une fois, d'après l'UNESCO.
const dejaDits = biens.map((b) => plier(b.nom).slice(0, 18));
const CATEGORIE = { culturel: 'bien culturel', naturel: 'bien naturel', mixte: 'bien mixte, culturel et naturel' } as const;
const liste = (l: string[]) => (l.length > 1 ? `${l.slice(0, -1).join(', ')} et ${l.at(-1)}` : l[0] ?? '');
const annee = (d: string | null) => (d ? d.slice(0, 4) : null);
const etat = (e: string) => e.replace('Mise en oeuvre', 'mise en œuvre').replace("En cours d'élaboration", 'en cours d’élaboration').replace('Dépôt pour avis', 'déposé pour avis');
// Une réserve de biosphère a trois zones publiées sous le même nom : une ligne par désignation.
const uniques = [...new Map(designations.map((z) => [`${z.rang}|${z.nom}`, z])).values()].filter(
  (z) => z.rang !== 12 || !dejaDits.some((d) => plier(z.nom).includes(d) || d.includes(plier(z.nom).slice(0, 18))),
);
const LIEN_NOEUD: Record<number, { id: string; texte: string }> = {
  10: { id: 'convention-ramsar', texte: 'la convention de Ramsar' },
  11: { id: 'unesco', texte: 'l’UNESCO' },
  12: { id: 'patrimoine-mondial', texte: 'le patrimoine mondial' },
};
---
{dessin && (
  <figure class="espaces-carte">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Carte de ${nom} et du patrimoine mondial qui la touche : ${[...new Set(dessin.traces.map((t) => `${t.nom}${t.zone === 'tampon' ? ' (zone tampon)' : ''}`))].join(', ')}.`}>
      <defs>
        <clipPath id={`${idCarte}-limite`}><path d={dessin.commune} /></clipPath>
        <pattern id={`${idCarte}-hachures`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line class="mondial-hachure" x1="0" y1="0" x2="0" y2="7" />
        </pattern>
      </defs>
      <path class="espaces-fond" d={dessin.commune} />
      <g clip-path={`url(#${idCarte}-limite)`}>
        {dessin.traces.map((t) =>
          t.zone === 'tampon' ? (
            <path class="mondial-tampon" d={t.d} fill={`url(#${idCarte}-hachures)`}><title>{`${t.nom} — zone tampon`}</title></path>
          ) : (
            <path class="mondial-bien" d={t.d}><title>{t.nom}</title></path>
          ),
        )}
      </g>
      <path class="espaces-limite" d={dessin.commune} />
    </svg>
    <figcaption class="espaces-legende">
      {dessin.traces.some((t) => t.zone === 'bien') && <span><i class="espaces-cle mondial-cle-bien" aria-hidden="true"></i>Bien inscrit au patrimoine mondial</span>}
      {dessin.traces.some((t) => t.zone === 'tampon') && <span><i class="espaces-cle mondial-cle-tampon" aria-hidden="true"></i>Zone tampon</span>}
    </figcaption>
  </figure>
)}
<ul class="mesure c-international">
  {epci && (
    <li>
      <strong>Le climat.</strong>
      {plan ? (
        <>
          {` ${plan.porteur} porte un plan climat-air-énergie territorial — « ${plan.nom} » —, ${etat(plan.etat)}`}
          {annee(plan.lancement) ? `, lancé en ${annee(plan.lancement)}` : ''}
          {plan.oblige === true ? ' ; le registre le dit obligé, l’intercommunalité dépassant 20 000 habitants.' : plan.oblige === false ? ' ; le registre le dit volontaire.' : '.'}
        </>
      ) : (
        ` Le registre de l’ADEME ne porte pas de plan climat-air-énergie pour ${epci.nom} — ce qui ne dit pas qu’il n’y en a pas.`
      )}
      {' C’est le bout local de '}<a href="/n/accord-de-paris">l’accord de Paris</a>{plan
        ? ', décliné par la stratégie nationale bas-carbone, que ce plan doit prendre en compte.'
        : ', décliné par la stratégie nationale bas-carbone, que le plan d’une intercommunalité de plus de 20 000 habitants doit prendre en compte.'}
    </li>
  )}
  {biens.map((b) => ({ ...b, elements: b.elements.filter((e) => plier(e) !== plier(nom)) })).map((b) => (
    <li>
      <strong>Patrimoine mondial.</strong>
      {b.mode === 'perimetre'
        ? ` ${nom} est dans le périmètre de `
        : b.mode === 'tampon'
          ? ` ${nom} est dans la zone tampon de `
          : b.elements.length
            ? ` L’UNESCO situe à ${nom} ${b.elements.length > 1 ? 'des éléments' : 'un élément'} de `
            : ` L’UNESCO situe à ${nom} `}
      <a href={lienUnesco(b.id)} target="_blank" rel="noopener">{`« ${b.nom} »`}</a>{`, ${CATEGORIE[b.categorie]}${b.inscrit ? ` inscrit en ${b.inscrit}` : ''}${b.elements.length ? ` — ${liste(b.elements)} —` : ''} au titre de la `}<a href="/n/patrimoine-mondial">convention du patrimoine mondial</a>{b.mode === 'tampon' ? '. La zone tampon entoure le bien pour lui ajouter une protection.' : '.'}
    </li>
  ))}
  {uniques.map((z) => (
    <li>
      <strong>{z.nature}.</strong>
      {` ${nom} est concernée par « ${z.nom} »`}{LIEN_NOEUD[z.rang] ? <>{', au titre de '}<a href={`/n/${LIEN_NOEUD[z.rang].id}`}>{LIEN_NOEUD[z.rang].texte}</a>{'.'}</> : '.'}
    </li>
  ))}
</ul>
<p class="p-source-territoire">
  {`Plans climat : registre Territoires & Climat de l’ADEME (Licence Ouverte)${majPlans ? `, lu le ${majPlans.split('-').reverse().join('/')}` : ''} — sans les noms des chefs de projet ni des élus référents. ` +
    'Désignations internationales : périmètres de l’INPN, croisés avec la commune (voir « Les espaces naturels »). ' +
    `Patrimoine mondial : la liste de l’UNESCO (CC BY-SA 4.0${majMondial ? `, mise à jour le ${majMondial.split('-').reverse().join('/')}` : ''}), dont les éléments sont situés par leurs coordonnées, et les périmètres et zones tampons publiés par les DREAL d’Occitanie, de Bretagne, de Nouvelle-Aquitaine, de Normandie et de Bourgogne-Franche-Comté, par la Mission Bassin Minier et par Vichy Communauté. Ailleurs, un bien étendu n’est rattaché qu’aux communes de ses éléments : une commune absente peut en faire partie.`}
</p>
