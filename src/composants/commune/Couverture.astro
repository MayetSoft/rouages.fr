---
/**
 * La couverture 4G théorique de la commune, d'après les cartes que l'Arcep
 * collecte auprès des opérateurs : en part de sa surface et en part de ses
 * habitants (carroyage de l'INSEE), pour au moins un opérateur puis
 * opérateur par opérateur. Voir `scripts/couverture-emettre.ts`.
 */
import type { CouvertureMobile, PartsParOperateur } from '../../modele/fiche-vie.ts';
import { enFrancais } from '../../modele/urbanisme.ts';

interface Props {
  c: CouvertureMobile;
}
const { c } = Astro.props;
const au = enFrancais(c.au);
const pc = (v: number) => `${v} %`;
const nf = (v: number) => v.toLocaleString('fr-FR');
const bonne = (x: PartsParOperateur) => x.meilleure.tbc + x.meilleure.bc;
const tableaux: { titre: string; libelle: string; x: PartsParOperateur }[] = [
  ...(c.surface ? [{ titre: 'Part de la surface de la commune, par niveau de couverture 4G', libelle: 'surface', x: c.surface }] : []),
  ...(c.parHabitants ? [{ titre: 'Part des habitants de la commune, par niveau de couverture 4G', libelle: 'habitants', x: c.parHabitants }] : []),
];
const phrase =
  (c.surface
    ? `Avec au moins un opérateur, ${pc(bonne(c.surface))} de la surface de la commune est en bonne ou très bonne couverture 4G, et ` +
      (c.surface.meilleure.aucune ? `${pc(c.surface.meilleure.aucune)} n’est couverte par aucun` : 'moins de 1 % n’est couverte par aucun')
    : 'La commune est trop petite pour la mesure en surface, faite sur une grille d’un point tous les 200 mètres environ') +
  (c.parHabitants && c.habitants
    ? ` ; ${pc(bonne(c.parHabitants))} de ses ${nf(c.habitants)} habitants vivent en bonne ou très bonne couverture` +
      (c.parHabitants.meilleure.aucune ? `, ${pc(c.parHabitants.meilleure.aucune)} sans couverture d’aucun opérateur` : '')
    : '') +
  `. D’après les cartes théoriques des opérateurs au ${au}.`;
---
<p class="mesure">{phrase}</p>
{tableaux.map((t) => (
  <div class="cpt-defile" tabindex="0" role="region" aria-label={`La couverture 4G par opérateur, en ${t.libelle} — le tableau défile sur les petits écrans`}>
    <table class="cpt-tableau">
      <caption>{t.titre}</caption>
      <thead>
        <tr>
          <th scope="col">Opérateur</th>
          <th scope="col">Très bonne</th>
          <th scope="col">Bonne</th>
          <th scope="col">Limitée</th>
          <th scope="col">Aucune</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Au moins un</th>
          <td>{pc(t.x.meilleure.tbc)}</td>
          <td>{pc(t.x.meilleure.bc)}</td>
          <td>{pc(t.x.meilleure.cl)}</td>
          <td>{pc(t.x.meilleure.aucune)}</td>
        </tr>
        {t.x.operateurs.map((o) => (
          <tr>
            <th scope="row">{o.nom}</th>
            <td>{pc(o.tbc)}</td>
            <td>{pc(o.bc)}</td>
            <td>{pc(o.cl)}</td>
            <td>{pc(o.aucune)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
))}
<p class="p-strate">
  Très bonne couverture&nbsp;: on devrait pouvoir échanger des données à l’extérieur des bâtiments et, dans la plupart
  des cas, à l’intérieur&nbsp;; bonne&nbsp;: à l’extérieur dans la plupart des cas, à l’intérieur dans certains&nbsp;;
  limitée&nbsp;: à l’extérieur dans la plupart des cas, probablement pas à l’intérieur. Ce sont des simulations des
  opérateurs, que l’Arcep vérifie par des mesures, pas des relevés. En surface, sur une grille d’un point tous les
  200 mètres environ, une forêt pèse autant qu’un bourg&nbsp;; en habitants, chaque carreau de 200 mètres du
  carroyage de l’INSEE pèse ceux qui y vivent — les ménages fiscaux, sans les personnes en maison de retraite ou en
  internat, avec des valeurs estimées par l’INSEE dans les carreaux de moins de onze ménages.
  Pour une adresse, <a href="https://monreseaumobile.arcep.fr/" target="_blank" rel="noopener">la carte de l’Arcep</a>.
</p>
<p class="p-source-territoire">
  {`D’après les cartes de couverture théorique 4G que l’Arcep collecte chaque trimestre auprès des opérateurs (jeu « Mon Réseau Mobile »), au ${au}, croisées avec les contours des communes (IGN, Admin Express)` +
    (c.parHabitants && c.carroyage ? ` et le carroyage de l’INSEE (Filosofi ${c.carroyage}, carreaux de 200 mètres)` : '') +
    `. Calcul du ${c.maj}.`}
</p>
