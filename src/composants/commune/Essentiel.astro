---
/**
 * L'essentiel, en haut de la page : cinq à dix chiffres, chacun renvoyant au
 * bloc qui l'explique.
 *
 * La page d'une commune dépasse dix écrans, et la plupart des lecteurs ne
 * descendront pas jusqu'au bout. Ce qui est ici n'est pas un résumé de plus :
 * c'est un sommaire chiffré. Aucun nombre n'y apparaît qui ne soit pas, plus
 * bas, rapporté à sa médiane et à sa source — la carte ne fait que les
 * remonter, et elle ne montre que ceux que la page porte vraiment.
 */
import type { ComplementsFiche } from '../../modele/fiche-commune.ts';
import type { ComplementsVie } from '../../modele/fiche-vie.ts';

interface Props {
  plus: ComplementsFiche;
  vie: ComplementsVie;
  population: number;
  /** Les faits datés du journal, sur sa fenêtre de six mois. */
  faits: number;
  /** Le plafond au-delà duquel le journal ne compte plus. */
  plafond: number;
}
const { plus, vie, population, faits, plafond } = Astro.props;
const nb = (v: number) => v.toLocaleString('fr-FR');
const pc = (v: number) => `${v.toLocaleString('fr-FR', { maximumFractionDigits: 0 })} %`;
// Au dixième là où le bloc l'écrit au dixième : la carte ne doit pas dire 41 % quand le bloc dit 40,8 %.
const pc1 = (v: number) => `${v.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} %`;
const euros = (v: number) => `${Math.round(v).toLocaleString('fr-FR')} €`;

type Carte = { id: string; nom: string; valeur: string; detail: string | null };
const cartes: Carte[] = [];

// Les habitants : le nombre, et la part des 60 ans ou plus quand la pyramide
// est là — c'est ce qui dit le plus vite à quelle commune on a affaire.
if (population > 0) {
  let detail: string | null = null;
  const a = plus.ages;
  if (a) {
    const i60 = a.tranches.indexOf(60);
    const tot = [...a.femmes, ...a.hommes].reduce((s, x) => s + x, 0);
    const ages = [...a.femmes.slice(i60), ...a.hommes.slice(i60)].reduce((s, x) => s + x, 0);
    if (tot > 0 && i60 >= 0) detail = `${pc((ages / tot) * 100)} ont 60 ans ou plus`;
  }
  cartes.push({ id: 'habitants', nom: 'Habitants', valeur: nb(population), detail });
}

// Le niveau de vie médian, quand le secret statistique ne le couvre pas.
const nv = plus.niveauDeVie;
if (nv && nv.mediane !== null) {
  cartes.push({
    id: 'niveaux',
    nom: 'Niveau de vie médian',
    valeur: `${euros(nv.mediane)} par an`,
    detail: nv.metropole?.mediane != null ? `France métropolitaine ${euros(nv.metropole.mediane)}` : null,
  });
}

// Le médecin : l'accès aux généralistes, au dixième comme dans le bloc.
const sante = vie.sante;
if (sante) {
  const i = sante.apl.findLastIndex((a) => a[0] !== null);
  const un = (v: number) => v.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const fr = sante.france?.[i];
  cartes.push({
    id: 'sante',
    nom: 'Accès aux généralistes',
    valeur: `${un(sante.apl[i][0]!)} consultations par an`,
    detail: fr != null ? `France ${un(fr)} ; sous-dotée à 2,5` : 'sous-dotée à 2,5',
  });
}

// Le prix d'une maison, quand il y a assez de ventes pour une médiane.
const maisons = vie.immobilier?.commune;
if (maisons && maisons.prixMaison !== null) {
  cartes.push({
    id: 'logements',
    nom: 'Prix médian d’une maison',
    valeur: euros(maisons.prixMaison),
    detail: `${nb(maisons.maisons)} ventes de ${vie.immobilier!.annees[0]} à ${vie.immobilier!.annees.at(-1)}`,
  });
}

// Le loyer d'annonce d'un appartement type, au centime comme dans le bloc.
const loyer = vie.loyers?.appartement ?? vie.loyers?.maison;
if (loyer && vie.loyers) {
  const quoi = vie.loyers.appartement ? 'appartement de 52 m²' : 'maison de 92 m²';
  cartes.push({
    id: 'loyers',
    nom: 'Loyer d’annonce',
    valeur: `${loyer.euros.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €/m²`,
    detail: `${quoi}, charges comprises`,
  });
}

// L'accueil des tout-petits, à l'échelle que le bloc annonce.
const pe = vie.petiteEnfance;
if (pe) {
  const un = (v: number) => v.toLocaleString('fr-FR', { maximumFractionDigits: 1 });
  cartes.push({
    id: 'petite-enfance',
    nom: 'Accueil des moins de 3 ans',
    valeur: `${un(pe.taux.global)} places pour 100`,
    detail: `${pe.echelle === 'commune' ? 'dans la commune' : 'dans l’intercommunalité'} ; France ${un(pe.france.global)}`,
  });
}

// La fibre : la part des locaux raccordables, arrondie comme dans le bloc.
const fibre = vie.fibre;
if (fibre && fibre.locaux > 0) {
  cartes.push({
    id: 'reseaux',
    nom: 'Raccordables à la fibre',
    valeur: pc(Math.round((fibre.raccordables / fibre.locaux) * 100)),
    detail: fibre.finCuivre ? `cuivre fermé fin ${fibre.finCuivre}` : `des ${nb(fibre.locaux)} locaux`,
  });
}

if (plus.scrutin?.tete) {
  const t = plus.scrutin.tete;
  cartes.push({
    id: 'election',
    nom: 'La liste arrivée en tête',
    valeur: `${pc1(t.part)} des inscrits`,
    detail: `médiane ${pc1(t.mediane)}`,
  });
}

const fonctionnement = plus.finances?.reperes.find((r) => r.id === 'repere-fonctionnement');
if (fonctionnement && fonctionnement.valeur !== null) {
  cartes.push({
    id: 'comptes',
    nom: 'Dépenses de fonctionnement',
    valeur: `${euros(fonctionnement.valeur)} par habitant`,
    detail: fonctionnement.mediane !== null ? `médiane de la strate ${euros(fonctionnement.mediane)}` : null,
  });
}

// Ce que l'État a subventionné, en investissement, sur la période du bloc.
const inv = vie.investissement;
if (inv && inv.projets.length > 0) {
  const total = inv.projets.reduce((t, p) => t + p.subvention, 0);
  cartes.push({
    id: 'investissement',
    nom: 'Projets subventionnés par l’État',
    valeur: euros(total),
    detail: `${nb(inv.projets.length)} projet${inv.projets.length > 1 ? 's' : ''}, ${inv.exercices[0]} à ${inv.exercices.at(-1)}`,
  });
}

// Le zonage le plus parlant : la montagne, sinon un programme de l'ANCT.
const z = vie.zonages;
if (z && (z.montagne !== 'non' || z.programmes.some((p) => ['pvd', 'acv', 'va'].includes(p)))) {
  const prog = z.programmes.includes('pvd')
    ? 'Petites villes de demain'
    : z.programmes.includes('acv')
      ? 'Action cœur de ville'
      : z.programmes.includes('va')
        ? 'Villages d’avenir'
        : null;
  cartes.push({
    id: 'zonages',
    nom: 'Programmes et zonages',
    valeur: z.montagne === 'oui' ? 'Zone de montagne' : z.montagne === 'en partie' ? 'En partie en montagne' : prog!,
    detail: z.montagne !== 'non' && prog ? prog : z.abc ? `zone ${z.abc} du zonage ABC` : null,
  });
}

if (plus.presentes) {
  const p = plus.presentes;
  cartes.push({
    id: 'entreprises',
    nom: 'Établissements employeurs',
    valeur: nb(p.employeurs),
    detail: `sur ${nb(p.total)} établissements actifs`,
  });
}

const ccas = plus.centres?.centres.find((c) => c.type === 'CCAS');
if (ccas && plus.centres) {
  const i = plus.centres.annees.indexOf(ccas.dernier);
  const k = plus.centres.agregats.indexOf('Dépenses de fonctionnement');
  const v = i >= 0 && k >= 0 ? ccas.principal[k]?.[i] : null;
  if (typeof v === 'number') {
    cartes.push({ id: 'ccas', nom: 'Le CCAS', valeur: euros(v), detail: `de dépenses en ${ccas.dernier}` });
  }
}

if (faits > 0) {
  cartes.push({
    id: 'journal',
    nom: 'Ce qui a bougé',
    valeur: faits >= plafond ? `plus de ${nb(plafond)} faits` : `${nb(faits)} fait${faits > 1 ? 's' : ''}`,
    detail: 'datés, en six mois',
  });
}
---
{cartes.length >= 3 && (
  <section class="c-essentiel" aria-labelledby="essentiel-titre">
    <h2 id="essentiel-titre" class="badge">L’essentiel</h2>
    <ul class="c-essentiel-liste">
      {cartes.map((c) => (
        <li>
          <a class="c-essentiel-carte" href={`#${c.id}`}>
            <span class="c-essentiel-nom">{c.nom}</span>
            <span class="c-essentiel-valeur">{c.valeur}</span>
            {c.detail && <span class="c-essentiel-detail">{c.detail}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
