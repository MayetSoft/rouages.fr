---
/**
 * Ce qui mérite une visite, d'après les offices de tourisme. Une base de
 * promotion, pas un inventaire : la page le dit, et ne montre ni commerce ni
 * hébergement — voir `scripts/lieux-emettre.ts`.
 */
import type { Lieu, Lieux } from '../../modele/fiche-vie.ts';

interface Props {
  l: Lieux;
}
const { l } = Astro.props;
const MONTRES = 15;

/**
 * Plusieurs fiches pour un même lieu — « Aventure Nature : pour les 3-4 ans »,
 * « … pour les 5-6 ans » — se regroupent sous leur nom commun, avec le lien
 * de la première.
 */
function regrouper(lieux: Lieu[]): Lieu[] {
  const prefixe = (n: string) => n.split(' : ')[0].trim();
  const compte = new Map<string, number>();
  for (const l of lieux) compte.set(prefixe(l.nom), (compte.get(prefixe(l.nom)) ?? 0) + 1);
  const vus = new Set<string>();
  const out: Lieu[] = [];
  for (const l of lieux) {
    const p = prefixe(l.nom);
    const k = compte.get(p) ?? 1;
    if (k === 1) out.push(l);
    else if (!vus.has(p)) {
      vus.add(p);
      out.push({ nom: `${p} (${k} fiches)`, fiche: l.fiche });
    }
  }
  return out;
}

const familles = [
  { titre: 'Patrimoine', lieux: regrouper(l.patrimoine) },
  { titre: 'Sites naturels', lieux: regrouper(l.nature) },
  { titre: 'Itinéraires', lieux: regrouper(l.itineraires) },
].filter((f) => f.lieux.length > 0);
---
{familles.length === 0 ? (
  <p class="mesure">
    Les offices de tourisme n’ont décrit dans la base nationale aucun lieu de patrimoine, site naturel ou itinéraire
    dans la commune.
  </p>
) : (
  familles.map((f) => (
    <>
      <h3 class="p-titre-echelon">{f.titre}</h3>
      <ul class="c-structures">
        {f.lieux.slice(0, MONTRES).map((x) => (
          <li>{x.fiche ? <a href={x.fiche} target="_blank" rel="noopener">{x.nom}</a> : x.nom}</li>
        ))}
      </ul>
      {f.lieux.length > MONTRES && <p class="p-strate">{`Et ${f.lieux.length - MONTRES} autres.`}</p>}
    </>
  ))
)}
<p class="p-strate">
  C’est ce que les offices de tourisme ont choisi de décrire, pas un inventaire&nbsp;: le petit patrimoine — lavoirs,
  croix, fontaines — n’y figure que là où un office l’a saisi, et aucune base nationale ouverte ne le recense. La
  commune est celle qu’indique la fiche. Ni commerce, ni hébergement, ni événement.
</p>
<p class="p-source-territoire">
  {`D’après DATAtourisme, la base nationale des données touristiques alimentée par les offices de tourisme (${l.maj}). Chaque nom mène à sa fiche sur la plateforme.`}
</p>
