---
/**
 * L'intercommunalité, le département et la région, depuis la page de la
 * commune : deux chiffres chacun, et le lien vers leur page.
 *
 * Le détail — lignes de tête, séries, tableau poste par poste — pesait une
 * vingtaine de kilo-octets, identiques sur les trois cents pages d'un même
 * département. Il a sa page, une fois par collectivité ; la commune garde de
 * quoi situer l'ordre de grandeur, et le chemin pour aller plus loin.
 */
import { COLLECTIVITES_UNIQUES, type ResumeEchelon } from '../../modele/fiche-commune.ts';

interface Props {
  echelons: ResumeEchelon[];
}
const { echelons } = Astro.props;
const eur = (v: number) => `${v.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} €`;
const qui = (e: ResumeEchelon) =>
  e.collectivite.echelon === 'intercommunalite'
    ? `L’intercommunalité — ${e.collectivite.nom}`
    : e.collectivite.echelon === 'departement'
    ? `Le département — ${e.collectivite.nom}`
    : COLLECTIVITES_UNIQUES.has(e.collectivite.code)
      ? `La collectivité unique — ${e.collectivite.nom}`
      : `La région — ${e.collectivite.nom}`;
---
<ul class="c-echelons">
  {echelons.map((e) => (
    <li>
      <a class="c-echelons-nom" href={e.lien}>{qui(e)}</a>
      {e.recettes !== null && e.depenses !== null && (
        <span class="c-echelons-detail">
          {`En ${e.annee}, ${eur(e.recettes)} encaissés et ${eur(e.depenses)} dépensés par habitant. `}
          <a href={e.lien}>Ses comptes, poste par poste</a>
        </span>
      )}
      {e.collectivite.echelon === 'departement' && e.collectivite.code === '75' && (
        <span class="c-echelons-detail">
          La Ville de Paris est à la fois commune et département : ce sont les mêmes comptes, ici sans les budgets
          annexes que ceux de la commune comprennent.
        </span>
      )}
    </li>
  ))}
</ul>
