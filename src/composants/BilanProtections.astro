---
/**
 * Ce qui protège et engage les communes d'un département ou d'une région : les
 * parcs, Natura 2000, le patrimoine mondial, les plans climat. Un bilan des
 * fichiers que la page de commune lit déjà (`src/modele/bilan-protections.ts`).
 */
import type { BilanProtections, PartsProtections } from '../modele/bilan-protections.ts';
import { lienUnesco } from '../modele/patrimoine-mondial.ts';

interface Props {
  b: BilanProtections;
  /** « le département », « la région » : pour les phrases. */
  ou: string;
  /** Les mêmes comptes pour la région (d'un département) et pour la France entière. */
  comparaison?: { ici: PartsProtections; region: PartsProtections | null; france: PartsProtections } | null;
  /** « Ce département », « Cette région » : l'en-tête de la première colonne. */
  titre?: string;
}
const { b, ou, titre = 'Ici' } = Astro.props;
// Une part calculée sur une seule commune — Paris — ne situe rien.
const comparaison = (Astro.props.comparaison?.ici.total ?? 0) > 1 ? Astro.props.comparaison! : null;
const part = (x: number, total: number) => (total ? `${(Math.round((1000 * x) / total) / 10).toLocaleString('fr-FR')} %` : '—');
const LIGNES: [keyof PartsProtections, string][] = [
  ['pnr', 'Dans un parc naturel régional'],
  ['parcNational', 'Dans un parc national (cœur ou aire d’adhésion)'],
  ['natura2000', 'Touchées par un site Natura 2000'],
  ['mondial', 'Rattachées à un bien du patrimoine mondial'],
  ['plan', 'Couvertes par le plan climat de leur intercommunalité'],
];
const n = (x: number) => x.toLocaleString('fr-FR');
const pluriel = (x: number, mot: string) => `${n(x)} ${mot}${x > 1 ? 's' : ''}`;
const pc = (x: number) => `${Math.round((100 * x) / b.total)} %`;
/** Au-delà de douze communes, on en montre douze et on compte le reste. */
const MONTREES = 12;
const MODE = { perimetre: 'dans le bien', tampon: 'zone tampon', ensemble: 'bien ou zone tampon', element: 'un élément' } as const;
const CATEGORIE = { culturel: 'bien culturel', naturel: 'bien naturel', mixte: 'bien mixte' } as const;
const date = (iso: string | null) => (iso ? iso.split('-').reverse().join('/') : '');
---
<ul class="mesure bp-chiffres">
  <li>
    <strong>{pluriel(b.pnr.reduce((s, p) => s + p.communes.length, 0), 'commune')}</strong>
    {` dans un parc naturel régional (${pc(b.pnr.reduce((s, p) => s + p.communes.length, 0))})`}
  </li>
  <li><strong>{pluriel(b.parcsNationaux.reduce((s, p) => s + p.communes.length, 0), 'commune')}</strong>{' dans un parc national, cœur ou aire d’adhésion'}</li>
  <li><strong>{pluriel(b.natura2000.communes, 'commune')}</strong>{` touchée${b.natura2000.communes > 1 ? 's' : ''} par ${pluriel(b.natura2000.sites, 'site')} Natura 2000 (${pc(b.natura2000.communes)})`}</li>
  <li>
    <strong>{`${n(b.plans.avecPlan)} intercommunalité${b.plans.avecPlan > 1 ? 's' : ''} sur ${n(b.plans.intercos)}`}</strong>
    {` portent un plan climat-air-énergie au registre de l’ADEME, pour ${pluriel(b.plans.communesCouvertes, 'commune')} de ${ou}`}
  </li>
</ul>

{comparaison && (
  <div class="rq-cadre">
    <table class="rq-table bp-comparaison">
      <caption>{`Part des communes, ${comparaison.region ? 'ici, dans la région et' : 'ici et'} dans la France entière`}</caption>
      <thead>
        <tr>
          <th scope="col">Communes…</th>
          <th scope="col" class="rq-nombre">{titre}</th>
          {comparaison.region && <th scope="col" class="rq-nombre">Sa région</th>}
          <th scope="col" class="rq-nombre">France entière</th>
        </tr>
      </thead>
      <tbody>
        {LIGNES.map(([k, libelle]) => (
          <tr>
            <th scope="row">{libelle}</th>
            <td class="rq-nombre">{part(comparaison.ici[k], comparaison.ici.total)}</td>
            {comparaison.region && <td class="rq-nombre">{part(comparaison.region[k], comparaison.region.total)}</td>}
            <td class="rq-nombre">{part(comparaison.france[k], comparaison.france.total)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
{comparaison && (
  <p class="p-source-territoire">
    {`Sur ${pluriel(comparaison.ici.total, 'commune')} ici${comparaison.region ? `, ${n(comparaison.region.total)} dans la région` : ''} et ${n(comparaison.france.total)} en France, outre-mer compris. ` +
      'Mêmes fichiers et mêmes règles que plus haut. Le patrimoine mondial se compare mal d’une région à l’autre : là où la région ne publie pas les périmètres de ses biens, seules les communes de leurs éléments sont rattachées.'}
  </p>
)}

{[
  ['Parcs naturels régionaux', b.pnr],
  ['Parcs nationaux', b.parcsNationaux],
].map(([titre, liste]) =>
  (liste as typeof b.pnr).length > 0 && (
    <>
      <h3 class="espaces-groupe">{titre as string}</h3>
      <ul class="c-structures">
        {(liste as typeof b.pnr).map((p) => (
          <li>
            <strong>{p.nom}</strong>{` — ${pluriel(p.communes.length, 'commune')} : `}{p.communes.slice(0, MONTREES).map((c, i) => (
              <>{i > 0 && ', '}<a href={`/commune/${c.code}`}>{c.nom}</a></>
            ))}{p.communes.length > MONTREES ? ` et ${n(p.communes.length - MONTREES)} autres.` : '.'}
          </li>
        ))}
      </ul>
    </>
  ),
)}

{b.biens.length > 0 && (
  <>
    <h3 class="espaces-groupe">Le patrimoine mondial</h3>
    <ul class="c-structures">
      {b.biens.map((bien) => (
        <li>
          <a href={lienUnesco(bien.id)} target="_blank" rel="noopener">{`« ${bien.nom} »`}</a>{`, ${CATEGORIE[bien.categorie]}${bien.inscrit ? ` inscrit en ${bien.inscrit}` : ''} — ${pluriel(bien.communes.length, 'commune')} : `}{bien.communes.slice(0, MONTREES).map((c, i) => (
            <>{i > 0 && ', '}<a href={`/commune/${c.code}#international`}>{c.nom}</a>{` (${MODE[c.mode]})`}</>
          ))}{bien.communes.length > MONTREES ? ` et ${n(bien.communes.length - MONTREES)} autres.` : '.'}
        </li>
      ))}
    </ul>
  </>
)}

<p class="p-source-territoire">
  {`Parcs et Natura 2000 : périmètres de l’INPN croisés avec les communes${b.majEspaces ? ` (${date(b.majEspaces)})` : ''}. ` +
    `Plans climat : registre Territoires & Climat de l’ADEME${b.majPlans ? `, lu le ${date(b.majPlans)}` : ''} — une intercommunalité absente du registre n’a pas forcément manqué à son obligation. ` +
    'Patrimoine mondial : liste de l’UNESCO et périmètres régionaux, là où ils sont publiés ; ailleurs, un bien n’est rattaché qu’aux communes de ses éléments.'}
</p>
