---
/**
 * Les jeux : ceux de Rouages, puis ceux bâtis ailleurs sur les données ouvertes.
 *
 * La page commence par ceux qui existent ailleurs (`contenu/jeux.yaml`) :
 * Rouages ne refait pas un jeu qui marche, il y renvoie, dans le même esprit
 * que pour Wikipédia ou Légifrance.
 *
 * Un jeu de Rouages n'y entre qu'une fois jouable : ceux qui se préparent
 * restent dans `docs/05-roadmap.md`, pas sur le site.
 */
import Base from '../layouts/Base.astro';
import Icone from '../composants/Icone.astro';
import type { NomIcone } from '../modele/icones.ts';
import { chargerGraphe, formaterDate } from '../modele/graphe.ts';
import type { Jeu } from '../modele/schemas.ts';

const g = chargerGraphe();
const jeux = [...g.jeux.values()];

const GENRES: { genre: Jeu['genre']; titre: string; chapo: string }[] = [
  { genre: 'devinette', titre: 'Deviner', chapo: 'Retrouver un lieu d’après ce que disent ses données.' },
  { genre: 'contribution', titre: 'Contribuer en jouant', chapo: 'Chaque réponse améliore la base de données elle-même.' },
  { genre: 'simulation', titre: 'Décider', chapo: 'Prendre une décision publique et en voir les effets.' },
];
/**
 * Les jeux de Rouages, par niveau. L'âge est un repère, pas une barrière : un
 * adulte s'amuse au puzzle de la carte, un collégien au jeu des prix.
 */
const NIVEAUX = [
  { id: 'decouvrir', emoji: '🌱', nom: 'Découvrir', age: 'dès 8 ans', chapo: 'Des parties courtes, beaucoup d’images, peu de texte : qui s’occupe de quoi, où sont les départements.' },
  { id: 'comprendre', emoji: '🔎', nom: 'Comprendre', age: 'dès 11 ans', chapo: 'Le budget de sa commune, une élection, qui décide vraiment : avec les vrais chiffres de chez soi.' },
  { id: 'approfondir', emoji: '🎓', nom: 'Approfondir', age: 'ados et adultes', chapo: 'Les prix de l’immobilier, les étapes d’une démarche : pour qui veut aller au fond des choses.' },
] as const;
type Carte = { cle: string | null; url: string; titre: string; icone: NomIcone; couleur: string; niveau: (typeof NIVEAUX)[number]['id']; age: string; duree: string; texte: string };
const NOTRES: Carte[] = [
  { cle: 'demande', url: '/jeux/a-qui-je-demande', titre: 'À qui je demande ?', icone: 'decide', couleur: 'decide', niveau: 'decouvrir', age: 'dès 8 ans', duree: '5 min', texte: 'Le toit de l’école, les poubelles, le train : cinq scènes, cinq portes. La mairie, le département, la région, l’État ?' },
  { cle: 'paires', url: '/jeux/qui-s-en-occupe', titre: 'Qui s’en occupe ?', icone: 'habitants', couleur: 'habitants', niveau: 'decouvrir', age: 'dès 8 ans', duree: '5 min', texte: 'Un jeu de paires : l’école et la mairie, le collège et le département, le lycée et la région.' },
  { cle: 'carte', url: '/jeux/puzzle-carte', titre: 'Le puzzle de la carte', icone: 'carte', couleur: 'nature', niveau: 'decouvrir', age: 'dès 8 ans', duree: '5 min', texte: 'La carte de ta région, sans les noms : où est l’Allier ? Clique sur le bon département.' },
  { cle: 'vraifaux', url: '/jeux/vrai-ou-faux', titre: 'Vrai ou faux : le maire peut-il… ?', icone: 'deliberations', couleur: 'suivre', niveau: 'decouvrir', age: 'dès 10 ans', duree: '5 min', texte: 'Fermer une classe, signer un permis, choisir les horaires du train : le maire peut-il tout faire ?' },
  { cle: 'plus', url: '/jeux/plus-ou-moins', titre: 'Plus ou moins', icone: 'habitants', couleur: 'habitants', niveau: 'decouvrir', age: 'dès 10 ans', duree: '5 min', texte: 'Deux communes face à face : laquelle a le plus d’habitants, la maison la plus chère, la gare la plus proche ?' },
  { cle: 'budget', url: '/jeux/budget', titre: 'Le budget de ma commune', icone: 'argent', couleur: 'argent', niveau: 'comprendre', age: 'dès 10 ans', duree: '5 min', texte: 'Ta commune dépense 100 € : combien pour les agents, pour construire, pour aider ? Devine, puis compare.' },
  { cle: null, url: '/jeux/election', titre: 'L’élection de la classe', icone: 'decide', couleur: 'decide', niveau: 'comprendre', age: 'dès 11 ans', duree: '10 min', texte: 'Vingt-cinq élèves, trois listes, sept sièges : trois façons de compter les mêmes voix, comme au conseil municipal.' },
  { cle: 'qui', url: '/jeux/qui-decide', titre: 'Qui décide ?', icone: 'decide', couleur: 'decide', niveau: 'comprendre', age: 'dès 12 ans', duree: '5 min', texte: 'L’eau, les déchets, la mobilité : dans votre commune, qui s’en occupe ? La réponse de sa page.' },
  { cle: 'argent', url: '/jeux/argent', titre: 'Où va l’argent ?', icone: 'argent', couleur: 'argent', niveau: 'comprendre', age: 'dès 12 ans', duree: '5 min', texte: 'Cinq missions du budget de l’État, à ranger de la plus grosse à la plus petite.' },
  { cle: 'mystere', url: '/jeux/commune-mystere', titre: 'La commune mystère', icone: 'carte', couleur: 'nature', niveau: 'comprendre', age: 'dès 12 ans', duree: '10 min', texte: 'Une commune se cache près de chez vous : retrouvez-la, indice après indice, avec la distance et la direction.' },
  { cle: 'prix', url: '/jeux/prix', titre: 'À combien s’est-elle vendue ?', icone: 'logement', couleur: 'logement', niveau: 'approfondir', age: 'ados et adultes', duree: '5 min', texte: 'Cinq vraies ventes de maisons et d’appartements autour de chez vous : devinez le prix.' },
  { cle: 'ordre', url: '/jeux/ordre', titre: 'Le bon ordre', icone: 'deliberations', couleur: 'suivre', niveau: 'approfondir', age: 'ados et adultes', duree: '5 min', texte: 'Les étapes d’une démarche, mélangées : le permis de construire, le budget communal, l’inscription électorale…' },
];
const groupes = GENRES.map((x) => ({ ...x, jeux: jeux.filter((j) => j.genre === x.genre) })).filter(
  (x) => x.jeux.length > 0,
);
---
<Base
  titre="Jeux"
  description="Des jeux sur les données publiques, dès 8 ans : qui s’occupe de l’école, le puzzle de la carte, le budget de ma commune, l’élection de la classe, le prix des maisons."
  section="jeux"
  image="/apercus/jeux.png"
>
  <div class="page page--etroite">
    <p class="badge">Jeux</p>
    <h1>Jouer avec les données publiques</h1>
    <p class="resume">
      Qui s’occupe de l’école, combien coûte une maison, comment se compte une élection&nbsp;: des jeux bâtis sur les
      vraies données de chez vous, du plus simple — dès 8 ans — au plus pointu. Et ceux que d’autres ont faits,
      plus bas.
    </p>

    <nav class="jeux-niveaux-nav" aria-label="Les niveaux">
      {NIVEAUX.map((n) => <a href={`#${n.id}`}>{`${n.emoji} ${n.nom}`}<small>{n.age}</small></a>)}
      <a href="/jeux/classe">🏫 Pour la classe<small>fiches pour l’enseignant</small></a>
    </nav>

    {NIVEAUX.map((n) => (
      <section class={`jeux-niveau jeux-niveau--${n.id}`} id={n.id}>
        <h2 class="jeux-niveau-titre">{`${n.emoji} ${n.nom}`} <small>{n.age}</small></h2>
        <p class="jeux-niveau-chapo">{n.chapo}</p>
        <ul class="jeux-cartes">
          {NOTRES.filter((j) => j.niveau === n.id).map((j) => (
            <li data-jeu={j.cle} data-theme-couleur={j.couleur}>
              <a class="jeux-carte" href={j.url}>
                <span class="pastille"><Icone nom={j.icone} /></span>
                <span class="jeux-carte-titre">{j.titre}</span>
                <span class="jeux-carte-texte">{j.texte}</span>
                <span class="jeux-carte-meta">{`${j.age} · ${j.duree}${j.cle ? ' · défi du jour' : ''}`}</span>
                {j.cle && <span class="jeux-etat" hidden></span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="mesure">
      Chaque jeu a son défi du jour, le même pour tout le monde, et se partage — le score, jamais les
      données d’une personne. Chaque réponse renvoie à sa fiche et à ses sources. Pour jouer en classe&nbsp;:{' '}
      <a href="/jeux/classe">les jeux par notion, avec une fiche pour l’enseignant</a>.
    </p>

    <h2 class="badge">Ailleurs</h2>
    {groupes.map((x) => (
      <section class="jeux-groupe">
        <h3>{x.titre}</h3>
        <p class="mesure">{x.chapo}</p>
        <ul class="jeux-liste">
          {x.jeux.map((j) => (
            <li>
              <a href={j.url} rel="noopener">{j.nom}</a>
              {j.support === 'sur_table' && <span class="jeux-support"> · sur table</span>}
              <p>{j.principe}</p>
              <p class="jeux-meta">
                {`Données : ${j.donnees}. En ligne le ${formaterDate(j.consulte_le)}.`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="mesure">
      Un jeu manque&nbsp;? <a href="/signaler">Proposez-le</a>. Il entre dans la liste s’il part de données
      publiques, ouvertes ou collaboratives, et s’il est jouable aujourd’hui.
    </p>
  </div>
</Base>

<script>
  import { historique, jourDeParis, serie, type CleJeu } from '../client/jeux-commun.ts';

  // L'état du défi du jour de chaque jeu, d'après la mémoire du navigateur.
  const jour = jourDeParis();
  for (const li of document.querySelectorAll<HTMLElement>('li[data-jeu]:not([data-jeu=""])')) {
    const cle = li.dataset.jeu as CleJeu;
    const etat = li.querySelector<HTMLElement>('.jeux-etat');
    if (!etat) continue;
    const fait = historique(cle)[jour];
    const n = serie(cle, jour);
    etat.textContent = fait
      ? `Fait aujourd’hui : ${fait.score}${n > 1 ? ` · ${n} jours de suite` : ''}`
      : `Défi du jour à jouer${n > 0 ? ` · série de ${n} jour${n > 1 ? 's' : ''} en cours` : ''}`;
    etat.classList.toggle('fait', !!fait);
    etat.hidden = false;
  }
</script>

<style>
  .jeux-groupe h3 { margin: 1.2rem 0 .2rem; font-size: 1.05rem; }
  .jeux-groupe .mesure { margin-top: 0; }
  .jeux-liste { list-style: none; padding: 0; margin: 0 0 1.4rem; max-width: var(--mesure); }
  .jeux-liste li { padding: .6rem 0; border-top: 1px solid var(--trait); }
  .jeux-liste a { font-weight: 600; }
  .jeux-liste p { margin: .25rem 0 0; }
  .jeux-support, .jeux-meta { color: var(--encre-douce); font-size: .88rem; }

  /* Les niveaux : un raccourci vers chacun, puis une boîte par niveau. */
  .jeux-niveaux-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin: .4rem 0 1.4rem; }
  .jeux-niveaux-nav a {
    display: grid; padding: .45rem .8rem; border-radius: var(--rayon); border: 1px solid var(--trait);
    background: var(--fond-carte); text-decoration: none; color: var(--encre); font-weight: 600;
  }
  .jeux-niveaux-nav a:hover { border-color: var(--accent); }
  .jeux-niveaux-nav small { font-weight: 400; font-size: .78rem; color: var(--encre-douce); }
  .jeux-niveau { border-radius: calc(var(--rayon) * 2); padding: 1rem 1rem .4rem; margin: 0 0 1.4rem; background: var(--fond-doux); scroll-margin-top: 1rem; }
  .jeux-niveau--decouvrir { background: color-mix(in srgb, #2e9e5b 9%, var(--fond)); }
  .jeux-niveau--comprendre { background: color-mix(in srgb, #3a6ea5 9%, var(--fond)); }
  .jeux-niveau--approfondir { background: color-mix(in srgb, #8a4b12 8%, var(--fond)); }
  .jeux-niveau-titre { font-family: var(--titre); font-size: 1.45rem; margin: 0; }
  .jeux-niveau-titre small { font-family: var(--texte, inherit); font-size: .85rem; font-weight: 400; color: var(--encre-douce); }
  .jeux-niveau-chapo { margin: .2rem 0 .8rem; max-width: var(--mesure); color: var(--encre-douce); }
  .jeux-cartes { list-style: none; padding: 0; margin: 0 0 .6rem; display: grid; gap: .7rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .jeux-carte {
    height: 100%; display: grid; grid-template-columns: 2.4rem 1fr; column-gap: .75rem; row-gap: .25rem; align-content: start;
    padding: .8rem .9rem; border-radius: var(--rayon); background: var(--fond-carte); border: 1px solid var(--trait);
    text-decoration: none; color: var(--encre); transition: border-color var(--transition), transform var(--transition);
  }
  .jeux-carte:hover, .jeux-carte:focus-visible { border-color: var(--accent); transform: translateY(-1px); }
  .jeux-carte > .pastille { grid-row: 1 / span 4; }
  .jeux-carte > :not(.pastille) { grid-column: 2; }
  .jeux-carte-titre { font-family: var(--titre); font-size: 1.15rem; font-weight: 620; line-height: 1.25; }
  .jeux-carte-texte { font-size: .92rem; color: var(--encre-douce); }
  .jeux-carte-meta { font-size: .8rem; color: var(--encre-douce); }
  .jeux-etat {
    justify-self: start; padding: .05rem .5rem; border-radius: 999px; font-size: .76rem;
    background: var(--accent-doux); color: var(--accent);
  }
  .jeux-etat.fait { background: var(--fond-doux); color: var(--encre-douce); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .jeux-niveau--decouvrir { background: color-mix(in srgb, #2e9e5b 14%, var(--fond)); }
    :root:not([data-theme="light"]) .jeux-niveau--comprendre { background: color-mix(in srgb, #3a6ea5 16%, var(--fond)); }
    :root:not([data-theme="light"]) .jeux-niveau--approfondir { background: color-mix(in srgb, #c98a4a 12%, var(--fond)); }
  }
</style>
