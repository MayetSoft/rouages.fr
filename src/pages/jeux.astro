---
/**
 * Les jeux : ceux de Rouages, puis ceux bâtis ailleurs sur les données ouvertes.
 *
 * La page commence par ceux qui existent ailleurs (`contenu/jeux.yaml`) :
 * Rouages ne refait pas un jeu qui marche, il y renvoie, dans le même esprit
 * que pour Wikipédia ou Légifrance.
 *
 * Un jeu de Rouages n'y entre qu'une fois jouable : ceux qui se préparent
 * restent dans `docs/05-roadmap.md`, pas sur le site.
 */
import Base from '../layouts/Base.astro';
import Icone from '../composants/Icone.astro';
import { chargerGraphe, formaterDate } from '../modele/graphe.ts';
import type { Jeu } from '../modele/schemas.ts';

const g = chargerGraphe();
const jeux = [...g.jeux.values()];

const GENRES: { genre: Jeu['genre']; titre: string; chapo: string }[] = [
  { genre: 'devinette', titre: 'Deviner', chapo: 'Retrouver un lieu d’après ce que disent ses données.' },
  { genre: 'contribution', titre: 'Contribuer en jouant', chapo: 'Chaque réponse améliore la base de données elle-même.' },
  { genre: 'simulation', titre: 'Décider', chapo: 'Prendre une décision publique et en voir les effets.' },
];
const groupes = GENRES.map((x) => ({ ...x, jeux: jeux.filter((j) => j.genre === x.genre) })).filter(
  (x) => x.jeux.length > 0,
);
---
<Base
  titre="Jeux"
  description="Des jeux bâtis sur les données ouvertes : deviner le prix d’une vraie vente immobilière, et les jeux qui existent ailleurs."
  section="jeux"
  image="/apercus/jeux.png"
>
  <div class="page page--etroite">
    <p class="badge">Jeux</p>
    <h1>Jouer avec les données publiques</h1>
    <p class="resume">
      Deviner un lieu d’après ses données, ou améliorer les données en jouant. D’autres ont déjà fait de
      très bons jeux à partir de données ouvertes&nbsp;: Rouages les recense et y renvoie, à côté des siens.
    </p>

    <h2 class="badge">Sur Rouages</h2>
    <ul class="jeux-liste">
      <li data-jeu="qui" data-theme-couleur="decide">
        <span class="pastille"><Icone nom="decide" /></span>
        <a href="/jeux/qui-decide">Qui décide&nbsp;?</a>
        <span class="jeux-etat" hidden></span>
        <p>L’eau, les déchets, la mobilité&nbsp;: dans votre commune, qui s’en occupe&nbsp;? Cinq questions, et la réponse de sa page.</p>
        <p class="jeux-meta">Données&nbsp;: le registre national BANATIC et la loi, comme sur chaque page de commune.</p>
      </li>
      <li data-jeu="mystere" data-theme-couleur="nature">
        <span class="pastille"><Icone nom="carte" /></span>
        <a href="/jeux/commune-mystere">La commune mystère</a>
        <span class="jeux-etat" hidden></span>
        <p>Une commune se cache dans votre code postal, votre intercommunalité ou votre département&nbsp;: retrouvez-la, indice après indice, avec la distance et la direction à chaque essai.</p>
        <p class="jeux-meta">Données&nbsp;: les contours d’Admin Express, et les chiffres des pages de commune.</p>
      </li>
      <li data-jeu="plus" data-theme-couleur="habitants">
        <span class="pastille"><Icone nom="habitants" /></span>
        <a href="/jeux/plus-ou-moins">Plus ou moins</a>
        <span class="jeux-etat" hidden></span>
        <p>Deux communes face à face&nbsp;: laquelle a le plus d’habitants, la maison la plus chère, la gare la plus proche&nbsp;?</p>
        <p class="jeux-meta">Données&nbsp;: INSEE, DGFiP, SNCF, Éducation nationale, avec leur année.</p>
      </li>
      <li data-jeu="prix" data-theme-couleur="logement">
        <span class="pastille"><Icone nom="logement" /></span>
        <a href="/jeux/prix">À combien s’est-elle vendue&nbsp;?</a>
        <span class="jeux-etat" hidden></span>
        <p>Cinq vraies ventes de maisons et d’appartements, autour de chez vous&nbsp;: devinez le prix.</p>
        <p class="jeux-meta">Données&nbsp;: les demandes de valeurs foncières de la DGFiP, les trois dernières années publiées.</p>
      </li>
      <li data-jeu="ordre" data-theme-couleur="suivre">
        <span class="pastille"><Icone nom="deliberations" /></span>
        <a href="/jeux/ordre">Le bon ordre</a>
        <span class="jeux-etat" hidden></span>
        <p>Les étapes d’une démarche publique, mélangées&nbsp;: le permis de construire, le budget communal, l’inscription électorale…</p>
        <p class="jeux-meta">Données&nbsp;: les fiches de démarche de Rouages.</p>
      </li>
      <li data-jeu="argent" data-theme-couleur="argent">
        <span class="pastille"><Icone nom="argent" /></span>
        <a href="/jeux/argent">Où va l’argent&nbsp;?</a>
        <span class="jeux-etat" hidden></span>
        <p>Cinq missions du budget de l’État, à ranger de la plus grosse à la plus petite.</p>
        <p class="jeux-meta">Données&nbsp;: les crédits votés pour 2025, d’après la direction du Budget.</p>
      </li>
    </ul>
    <p class="mesure">
      Chaque jeu a son défi du jour, le même pour tout le monde, et se partage — le score, jamais les
      données d’une personne.
    </p>

    <h2 class="badge">Ailleurs</h2>
    {groupes.map((x) => (
      <section class="jeux-groupe">
        <h3>{x.titre}</h3>
        <p class="mesure">{x.chapo}</p>
        <ul class="jeux-liste">
          {x.jeux.map((j) => (
            <li>
              <a href={j.url} rel="noopener">{j.nom}</a>
              {j.support === 'sur_table' && <span class="jeux-support"> · sur table</span>}
              <p>{j.principe}</p>
              <p class="jeux-meta">
                {`Données : ${j.donnees}. En ligne le ${formaterDate(j.consulte_le)}.`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="mesure">
      Un jeu manque&nbsp;? <a href="/signaler">Proposez-le</a>. Il entre dans la liste s’il part de données
      publiques, ouvertes ou collaboratives, et s’il est jouable aujourd’hui.
    </p>
  </div>
</Base>

<script>
  import { historique, jourDeParis, serie, type CleJeu } from '../client/jeux-commun.ts';

  // L'état du défi du jour de chaque jeu, d'après la mémoire du navigateur.
  const jour = jourDeParis();
  for (const li of document.querySelectorAll<HTMLElement>('li[data-jeu]')) {
    const cle = li.dataset.jeu as CleJeu;
    const etat = li.querySelector<HTMLElement>('.jeux-etat');
    if (!etat) continue;
    const fait = historique(cle)[jour];
    const n = serie(cle, jour);
    etat.textContent = fait
      ? `Fait aujourd’hui : ${fait.score}${n > 1 ? ` · ${n} jours de suite` : ''}`
      : `Défi du jour à jouer${n > 0 ? ` · série de ${n} jour${n > 1 ? 's' : ''} en cours` : ''}`;
    etat.classList.toggle('fait', !!fait);
    etat.hidden = false;
  }
</script>

<style>
  .jeux-groupe h3 { margin: 1.2rem 0 .2rem; font-size: 1.05rem; }
  .jeux-groupe .mesure { margin-top: 0; }
  .jeux-liste { list-style: none; padding: 0; margin: 0 0 1.4rem; max-width: var(--mesure); }
  .jeux-liste li { padding: .6rem 0; border-top: 1px solid var(--trait); }
  .jeux-liste a { font-weight: 600; }
  /* Les jeux de Rouages : leur icône à gauche, le reste en colonne. */
  .jeux-liste li[data-theme-couleur] { display: grid; grid-template-columns: 2.4rem 1fr; column-gap: .9rem; align-items: start; padding: .85rem 0; }
  .jeux-liste li[data-theme-couleur] > .pastille { grid-row: 1 / span 4; margin-top: .1rem; }
  .jeux-liste li[data-theme-couleur] > :not(.pastille) { grid-column: 2; }
  .jeux-liste li[data-theme-couleur] > a { font-family: var(--titre); font-size: 1.2rem; font-weight: 620; justify-self: start; }
  .jeux-liste li[data-theme-couleur] > .jeux-etat { justify-self: start; margin: .2rem 0 0; }
  .jeux-etat {
    display: inline-block; margin-left: .5rem; padding: .05rem .5rem; border-radius: 999px; font-size: .78rem;
    background: var(--accent-doux); color: var(--accent);
  }
  .jeux-etat.fait { background: var(--fond-doux); color: var(--encre-douce); }
  .jeux-liste p { margin: .25rem 0 0; }
  .jeux-support, .jeux-meta { color: var(--encre-douce); font-size: .88rem; }
</style>
