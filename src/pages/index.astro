---
/**
 * L'accueil : ce que fait le site, et par où entrer.
 *
 * La carte du réseau était la première chose qu'on voyait, et elle faisait
 * peur : des centaines de nœuds avant d'avoir compris à quoi ils servaient.
 * Elle est passée dans « Fonctionnement » ; ici, on explique, puis on propose
 * une porte par section — son territoire, la mécanique d'ensemble, l'argent
 * de l'État, les jeux, les simulateurs.
 */
import Base from '../layouts/Base.astro';
import ChampTerritoire from '../composants/ChampTerritoire.astro';
import Icone from '../composants/Icone.astro';
import type { NomIcone } from '../modele/icones.ts';
import { construireReseau } from '../modele/reseau.ts';
import { communes } from '../modele/territoires.ts';
import { budgetEtat } from '../modele/budget-etat.ts';

const reseau = construireReseau();
const noeud = (id: string) => reseau.noeuds.find((n) => n.id === id);
// Les questions qu'on se pose, plutôt que les rubriques du site : chacune mène
// à la page qui y répond. Une question sur une compétence n'est gardée que si
// sa fiche existe.
type Question = { q: string; lien: string; icone: NomIcone; theme: string; ou: string; noeud?: string };
const questions = (
  [
    { q: 'Combien vaut ma maison ?', lien: '/simulateurs/estimation', icone: 'logement', theme: 'logement', ou: 'le simulateur, d’après les ventes réelles' },
    { q: 'Qui s’occupe de l’eau du robinet ?', lien: '/n/eau-potable', noeud: 'eau-potable', icone: 'eau', theme: 'quotidien', ou: 'commune, intercommunalité ou syndicat' },
    { q: 'Qui ramasse mes poubelles ?', lien: '/n/dechets-menagers', noeud: 'dechets-menagers', icone: 'dechets', theme: 'nature', ou: 'la collecte et le traitement' },
    { q: 'Qui délivre un permis de construire ?', lien: '/n/delivrance-autorisation-urbanisme', noeud: 'delivrance-autorisation-urbanisme', icone: 'decide', theme: 'decide', ou: 'le maire, au nom de qui' },
    { q: 'Qui ouvre ou ferme une classe ?', lien: '/n/carte-scolaire', noeud: 'carte-scolaire', icone: 'ecole', theme: 'habitants', ou: 'la carte scolaire' },
    { q: 'Qui construit les collèges ?', lien: '/n/colleges', noeud: 'colleges', icone: 'collectivite', theme: 'habitants', ou: 'le département' },
    { q: 'Où va l’argent de l’État ?', lien: '/argent-public', icone: 'argent', theme: 'argent', ou: 'mission par mission' },
    { q: 'Trouverez-vous la commune mystère ?', lien: '/jeux/commune-mystere', icone: 'carte', theme: 'suivre', ou: 'un défi par jour, près de chez vous' },
  ] satisfies Question[]
).filter((x: Question) => !x.noeud || noeud(x.noeud));
const nCommunes = communes().length;
const plf = budgetEtat()?.plf ?? 2026;
const acteurs = reseau.noeuds.filter((n) => n.type === 'acteur').length;
const filtre = process.env.ROUAGES_DEPS?.split(',').map((d) => d.trim()).filter(Boolean);
const exemple = !filtre || filtre.length === 0 || filtre.includes('03');
---
<Base
  titre="Qui décide quoi, près de chez vous"
  description="L’école, l’eau, les routes, le permis de construire : Rouages dit quelle collectivité ou quelle administration décide et paie, commune par commune, d’après les données publiques."
  section="accueil"
>
  <div class="page accueil">
    <h1>Qui décide quoi, près de chez vous&nbsp;?</h1>
    <p class="resume accueil-chapo">
      L’école, l’eau du robinet, les routes, le permis de construire&nbsp;: derrière chaque service, une commune,
      une intercommunalité, un département, une région ou l’État décide, et paie. Rouages dit lequel, là où vous
      habitez, et montre ce que les données publiques disent de votre commune.
    </p>

    <ChampTerritoire id="accueil-champ" etiquette="Commencez par votre commune" />
    {exemple && (
      <p class="cm-exemple">Par exemple&nbsp;: <a href="/commune/03165">Le Mayet-de-Montagne</a>, dans l’Allier.</p>
    )}

    <h2 class="badge">Les questions qu’on se pose</h2>
    <ul class="accueil-questions-grille">
      {questions.map((x) => (
        <li>
          <a href={x.lien} data-theme-couleur={x.theme}>
            <span class="pastille"><Icone nom={x.icone} /></span>
            <span><strong>{x.q}</strong><small>{x.ou}</small></span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="badge">Par où entrer</h2>
    <div class="accueil-portes">
      <a class="accueil-porte" href="/chez-moi" data-theme-couleur="decide">
        <span class="pastille"><Icone nom="lieu" /></span>
        <span class="accueil-porte-titre">Données de chez moi</span>
        <span>
          {`Votre commune, votre intercommunalité, votre département ou votre région : qui y exerce quoi, ses comptes, ses écoles, ses services, ses risques, son élection. ${nCommunes.toLocaleString('fr-FR')} communes, chacune sa page.`}
        </span>
      </a>
      <a class="accueil-porte" href="/fonctionnement" data-theme-couleur="suivre">
        <span class="pastille"><Icone nom="reseau" /></span>
        <span class="accueil-porte-titre">Fonctionnement</span>
        <span>
          {`Le réseau des ${acteurs} institutions et de leurs liens : qui décide, qui finance, qui contrôle. Pour voir comment les pièces s’emboîtent.`}
        </span>
      </a>
      <a class="accueil-porte" href="/argent-public" data-theme-couleur="argent">
        <span class="pastille"><Icone nom="argent" /></span>
        <span class="accueil-porte-titre">L’argent public</span>
        <span>
          Ce que l’État dépense, mission par mission, programme par programme&nbsp;:
          {` ce qui a été dépensé en ${plf - 2}, voté pour ${plf - 1}, proposé pour ${plf}.`}
        </span>
      </a>
      <a class="accueil-porte" href="/jeux" data-theme-couleur="habitants">
        <span class="pastille"><Icone nom="jeux" /></span>
        <span class="accueil-porte-titre">Jeux</span>
        <span>
          Qui décide dans votre commune, la commune mystère, le prix d’une vraie vente… Un défi par jour, le même pour
          tout le monde, sur les données de votre territoire.
        </span>
      </a>
      <a class="accueil-porte" href="/simulateurs" data-theme-couleur="logement">
        <span class="pastille"><Icone nom="simulateurs" /></span>
        <span class="accueil-porte-titre">Simulateurs</span>
        <span>
          Ce que vaut une maison, un terrain, un pré près de chez vous&nbsp;: une estimation poste par poste, d’après
          les ventes réelles, avec sa précision mesurée.
        </span>
      </a>
    </div>

    <h2 class="badge">Sur la page d’une commune</h2>
    <ul class="accueil-themes">
      <li><strong>Qui exerce quoi</strong> — la commune, l’intercommunalité, le département, la région ou l’État, compétence par compétence.</li>
      <li><strong>L’argent</strong> — les comptes de la commune, les dotations de l’État, ce qui est prélevé et par qui.</li>
      <li><strong>La vie démocratique</strong> — l’élection municipale, le conseil, les délibérations, les votes nationaux.</li>
      <li><strong>Vivre là</strong> — les habitants, les écoles, le médecin, les services, les logements, ce qu’on trouve sur place.</li>
      <li><strong>Le territoire</strong> — les risques, l’eau, la fibre, ce qui peut s’y construire, le patrimoine, le train.</li>
    </ul>
    <p class="mesure">
      Et jusqu’à cinq communes se comparent bloc par bloc&nbsp;: <a href="/comparer">comparer des communes</a>.
    </p>

    <h2 class="badge">Ce que Rouages s’engage à faire</h2>
    <ul class="accueil-themes">
      <li><strong>Citer ses sources.</strong> Chaque chiffre vient d’une donnée publique, nommée et datée, avec le lien vers le fichier — dans l’encadré « Sources » de chaque bloc.</li>
      <li><strong>Nommer d’après un registre, sans conclure.</strong> Le site décrit des fonctions — le maire, le préfet. Les noms qu’il montre — élus, titulaires de marchés, entreprises — viennent d’un registre public, avec la source, la date et le lien vers la fiche d’origine&nbsp;; il n’en tire aucune conclusion, et l’on peut <a href="/signaler">demander un retrait</a>.</li>
      <li><strong>Relier plutôt que réécrire.</strong> Les explications existent déjà sur Wikipédia, Légifrance ou service-public.fr : Rouages y renvoie.</li>
      <li><strong>Dire ce qu’il ne sait pas.</strong> Quand une règle varie selon le territoire, ou qu’une donnée manque, la page le dit.</li>
    </ul>
    <p class="mesure">
      Comment tout cela est construit et vérifié&nbsp;: <a href="/methode">la méthode</a>. Une erreur&nbsp;?
      <a href="/signaler">Signalez-la</a>.
    </p>
  </div>
</Base>
<script is:inline>
  // L'ancienne adresse de la carte, `/#id`, a pu être partagée : elle mène
  // désormais au même nœud dans « Fonctionnement ».
  if (location.hash.length > 1) location.replace('/fonctionnement' + location.hash);
</script>
