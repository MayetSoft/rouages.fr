---
/**
 * L'accueil : ce que fait le site, et par où entrer.
 *
 * La carte du réseau était la première chose qu'on voyait, et elle faisait
 * peur : des centaines de nœuds avant d'avoir compris à quoi ils servaient.
 * Elle est passée dans « Fonctionnement » ; ici, on explique, puis on propose
 * deux portes — son territoire, ou la mécanique d'ensemble.
 */
import Base from '../layouts/Base.astro';
import ChampTerritoire from '../composants/ChampTerritoire.astro';
import { construireReseau } from '../modele/reseau.ts';
import { communes } from '../modele/territoires.ts';

const reseau = construireReseau();
const noeud = (id: string) => reseau.noeuds.find((n) => n.id === id);
const questions = (
  [
    ['eau-potable', 'Qui s’occupe de l’eau du robinet ?'],
    ['colleges', 'Qui construit et entretient les collèges ?'],
    ['delivrance-autorisation-urbanisme', 'Qui délivre un permis de construire ?'],
  ] as const
).filter(([id]) => noeud(id));
const nCommunes = communes().length;
const acteurs = reseau.noeuds.filter((n) => n.type === 'acteur').length;
const filtre = process.env.ROUAGES_DEPS?.split(',').map((d) => d.trim()).filter(Boolean);
const exemple = !filtre || filtre.length === 0 || filtre.includes('03');
---
<Base
  titre="Qui décide quoi, près de chez vous"
  description="L’école, l’eau, les routes, le permis de construire : Rouages dit quelle collectivité ou quelle administration décide et paie, commune par commune, d’après les données publiques."
  section="accueil"
>
  <div class="page accueil">
    <h1>Qui décide quoi, près de chez vous&nbsp;?</h1>
    <p class="resume accueil-chapo">
      L’école, l’eau du robinet, les routes, le permis de construire&nbsp;: derrière chaque service, une commune,
      une intercommunalité, un département, une région ou l’État décide, et paie. Rouages dit lequel, là où vous
      habitez, et montre ce que les données publiques disent de votre commune.
    </p>

    <ChampTerritoire id="accueil-champ" etiquette="Commencez par votre commune" />
    {exemple && (
      <p class="cm-exemple">Par exemple&nbsp;: <a href="/commune/03165">Le Mayet-de-Montagne</a>, dans l’Allier.</p>
    )}

    <div class="accueil-portes">
      <a class="accueil-porte" href="/chez-moi">
        <span class="accueil-porte-titre">Données de chez moi</span>
        <span>
          {`Votre commune, votre intercommunalité, votre département ou votre région : qui y exerce quoi, ses comptes, ses écoles, ses services, ses risques, son élection. ${nCommunes.toLocaleString('fr-FR')} communes, chacune sa page.`}
        </span>
      </a>
      <a class="accueil-porte" href="/fonctionnement">
        <span class="accueil-porte-titre">Fonctionnement</span>
        <span>
          {`La carte des ${acteurs} institutions et de leurs liens : qui décide, qui finance, qui contrôle. Pour voir comment les pièces s’emboîtent.`}
        </span>
      </a>
    </div>

    <h2 class="badge">Sur la page d’une commune</h2>
    <ul class="accueil-themes">
      <li><strong>Qui exerce quoi</strong> — la commune, l’intercommunalité, le département, la région ou l’État, compétence par compétence.</li>
      <li><strong>L’argent</strong> — les comptes de la commune, les dotations de l’État, ce qui est prélevé et par qui.</li>
      <li><strong>La vie démocratique</strong> — l’élection municipale, le conseil, les délibérations, les votes nationaux.</li>
      <li><strong>Vivre là</strong> — les habitants, les écoles, le médecin, les services, les logements, ce qu’on trouve sur place.</li>
      <li><strong>Le territoire</strong> — les risques, l’eau, la fibre, ce qui peut s’y construire, le patrimoine, le train.</li>
    </ul>
    <p class="mesure">
      Et deux communes se comparent bloc par bloc&nbsp;: <a href="/comparer">comparer deux communes</a>.
    </p>

    {questions.length > 0 && (
      <>
        <h2 class="badge">Trois questions pour commencer</h2>
        <ul class="accueil-questions">
          {questions.map(([id, q]) => <li><a href={`/n/${id}`}>{q}</a></li>)}
        </ul>
      </>
    )}

    <h2 class="badge">Ce que Rouages s’engage à faire</h2>
    <ul class="accueil-themes">
      <li><strong>Citer ses sources.</strong> Chaque chiffre vient d’une donnée publique, nommée et datée, avec le lien vers le fichier — dans l’encadré « Sources et méthode » de chaque bloc.</li>
      <li><strong>Ne nommer personne.</strong> Le site décrit des fonctions — le maire, le préfet —, jamais les personnes qui les occupent.</li>
      <li><strong>Relier plutôt que réécrire.</strong> Les explications existent déjà sur Wikipédia, Légifrance ou service-public.fr : Rouages y renvoie.</li>
      <li><strong>Dire ce qu’il ne sait pas.</strong> Quand une règle varie selon le territoire, ou qu’une donnée manque, la page le dit.</li>
    </ul>
    <p class="mesure">
      Comment tout cela est construit et vérifié&nbsp;: <a href="/methode">la méthode</a>. Une erreur&nbsp;?
      <a href="/signaler">Signalez-la</a>.
    </p>
  </div>
</Base>
<script is:inline>
  // L'ancienne adresse de la carte, `/#id`, a pu être partagée : elle mène
  // désormais au même nœud dans « Fonctionnement ».
  if (location.hash.length > 1) location.replace('/fonctionnement' + location.hash);
</script>
