---
/**
 * Le bon ordre : remettre dans l'ordre les étapes d'une procédure que décrit
 * le réseau, du permis de construire au budget communal.
 *
 * Les procédures viennent de `contenu/processus/`, telles que leurs fiches les
 * donnent ; seules celles dont la confiance est « établi » entrent. Un défi
 * par jour, le même pour tout le monde ; ensuite des parties libres.
 */
import Base from '../../layouts/Base.astro';
import ClassementJeu from '../../composants/jeux/ClassementJeu.astro';
import { chargerGraphe, formaterDelai } from '../../modele/graphe.ts';
import '../../styles/jeux.css';

const g = chargerGraphe();
/** Ce qu'un délai engage : un plafond, un plancher, un ordre de grandeur. */
const NATURE = { maximum_legal: 'au plus', minimum_legal: 'au moins', indicatif: 'environ', observe: 'en pratique' } as const;
/** [id, nom, étapes : [ordre, action, qui, conditionnelle, délai]] — dans l'ordre des id, pour que le tirage soit stable. */
const procedures = [...g.processus.values()]
  .filter((p) => p.confiance === 'etabli' && p.etapes.length >= 3 && p.etapes.every((e) => e.confiance === 'etabli'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((p) => [
    p.id,
    p.nom,
    [...p.etapes]
      .sort((a, b) => a.ordre - b.ordre)
      .map((e) => [
        e.ordre,
        e.action,
        g.acteurs.get(e.acteur)?.nom_court ?? g.acteurs.get(e.acteur)?.nom ?? '',
        e.conditionnelle ? 1 : 0,
        e.delai ? `délai : ${NATURE[e.delai.nature]} ${formaterDelai(e.delai)}` : '',
      ]),
  ]);
---
<Base
  titre="Le bon ordre"
  description="Remettez dans l’ordre les étapes d’une démarche publique : le permis de construire, le budget communal, l’inscription sur les listes électorales…"
  section="jeux"
  image="/apercus/ordre.png"
>
  <div class="page page--etroite">
    <p class="badge"><a href="/jeux">Jeux</a></p>
    <h1>Le bon ordre</h1>
    <p class="resume">
      {`Les étapes d’une démarche publique, mélangées : remettez-les dans l’ordre. Chaque jour, une des ${procedures.length} démarches que décrit le site, la même pour tout le monde.`}
    </p>

    <ClassementJeu
      id="jo"
      consigne="Du premier geste à la décision : glissez chaque étape à sa place — ou montez-la, descendez-la par les flèches —, puis validez. Trois essais ; les étapes bien placées restent en place."
      autre="Une autre démarche, au hasard"
    />

    <h2 class="badge">La règle</h2>
    <ul class="accueil-themes">
      <li>Trois essais. Après chacun, les étapes à leur place passent au vert et ne bougent plus.</li>
      <li>Une case par étape&nbsp;: 🟩 trouvée au premier essai, 🟨 au deuxième, 🟧 au troisième, 🟥 jamais.</li>
      <li>«&nbsp;Si besoin&nbsp;» marque une étape qui n’a pas toujours lieu&nbsp;: un recours, une enquête complémentaire. Elle a quand même sa place dans l’ordre.</li>
      <li>Votre résultat du jour reste dans votre navigateur. Le partage prépare un texte — les cases et le score, pas la démarche — que vous publiez où vous voulez.</li>
    </ul>

    <h2 class="badge">Sources</h2>
    <p class="mesure">
      Les fiches de démarche de Rouages, chacune avec ses références&nbsp;: textes de loi, pages de
      service-public.fr. La fiche de la démarche du jour s’ouvre à la fin de la partie.
    </p>
  </div>
</Base>

<script type="application/json" is:inline id="jo-donnees" set:html={JSON.stringify(procedures)} />
<script>
  import { brancherClassement } from '../../client/jeux-classement.ts';

  /** [id, nom, étapes : [ordre, action, qui, conditionnelle, délai]] */
  type Procedure = [string, string, [number, string, string, 0 | 1, string][]];
  const procedures = JSON.parse(document.getElementById('jo-donnees')?.textContent ?? '[]') as Procedure[];
  if (procedures.length > 0) {
    brancherClassement({
      cle: 'ordre',
      prefixe: 'jo',
      jeu: 'Le bon ordre',
      embleme: '🔢',
      memoire: 'rouages-jeu-ordre',
      mot: 'étape',
      tirer: (alea) => {
        const [id, nom, etapes] = procedures[Math.floor(alea() * procedures.length)];
        return {
          titre: nom,
          // Le délai de chaque étape ne paraît qu'avec la réponse : il apprend quelque chose, sans souffler l'ordre.
          elements: etapes.map(([, action, qui, cond, delai]) => ({ texte: action, precision: [qui, cond ? 'si besoin' : ''].filter(Boolean).join(' · '), reponse: delai })),
          apres: (contexte) => {
            contexte.append(Object.assign(document.createElement('a'), { href: `/n/${id}`, textContent: `La fiche « ${nom} »` }), ' : les délais, les recours, qui décide.');
          },
        };
      },
    });
  }
</script>
