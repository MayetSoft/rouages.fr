---
/**
 * Mentions légales, données personnelles, licences et attribution.
 *
 * L'identité de l'éditeur ne se déduit d'aucune donnée : elle est déclarée
 * dans `contenu/editeur.yaml`, et `npm run publier` refuse de générer le site
 * tant qu'un champ porte encore sa valeur d'attente. La page ne peut donc pas
 * partir vide en production — elle peut l'être en développement, et le dit.
 *
 * La liste des jeux réutilisés est construite depuis la veille plutôt que
 * recopiée : c'est elle qui sait ce que le site ingère réellement, et une liste
 * écrite à la main vieillirait en silence dès la source suivante.
 */
import Base from '../layouts/Base.astro';
import { chargerGraphe } from '../modele/graphe.ts';
import { ATTENTE_EDITEUR } from '../modele/schemas.ts';
import { DEPOT } from '../modele/signalement.ts';

const g = chargerGraphe();
const editeur = g.editeur;
const incomplet = (v: string | undefined) => !v || v.trim() === ATTENTE_EDITEUR;

// Les sources que le site ingère, et non celles vers lesquelles il renvoie :
// la veille les surveille une par une, et c'est sur elles que pèse
// l'obligation de paternité de la Licence Ouverte.
const jeux = [...g.surveillances.values()]
  .map((s) => ({
    nom: s.nom,
    alimente: s.alimente,
    lien: s.lien ? g.sources.get(s.lien) : undefined,
    licence: s.licence,
    fichiers: s.fichiers ?? [],
  }))
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));

// Les licences, dans l'ordre où elles engagent le plus : l'ODbL d'abord, parce
// qu'elle oblige le site à republier sous la même licence ce qu'il en tire.
const LICENCES = [
  { code: 'odbl', nom: 'Open Database License (ODbL)', url: 'https://opendatacommons.org/licenses/odbl/1-0/' },
  { code: 'licence-ouverte-2.0', nom: 'Licence Ouverte 2.0', url: 'https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf' },
  { code: 'licence-ouverte-1.0', nom: 'Licence Ouverte 1.0', url: 'https://www.etalab.gouv.fr/wp-content/uploads/2014/05/Licence_Ouverte.pdf' },
  { code: 'licence-ouverte', nom: 'Licence Ouverte, sans version précisée', url: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence' },
  { code: 'cc0', nom: 'Creative Commons Zero (CC0 1.0), domaine public', url: 'https://creativecommons.org/publicdomain/zero/1.0/deed.fr' },
  { code: 'variable', nom: 'Licence choisie par chaque publieur', url: null },
  { code: 'non-precisee', nom: 'Licence non précisée par le producteur', url: null },
] as const;
const parLicence = LICENCES.map((l) => ({ ...l, jeux: jeux.filter((j) => j.licence === l.code) })).filter((l) => l.jeux.length > 0);
const nb = (code: string) => jeux.filter((j) => j.licence === code).length;
const ouvertes = nb('licence-ouverte-2.0') + nb('licence-ouverte-1.0') + nb('licence-ouverte');
---

<Base
  titre="Mentions légales"
  description="Qui édite Rouages, ce que le site collecte — presque rien — et sous quelles licences il republie des données publiques."
>
  <div class="page">
    <h1>Mentions légales</h1>
    <p class="resume">
      Qui publie ce site, ce qu’il sait de vous — presque rien — et sous quelles
      conditions ce qu’il montre peut être réutilisé.
    </p>

    <h2 class="badge">Éditeur</h2>
    {editeur && !incomplet(editeur.nom) ? (
      <dl class="mentions">
        <div><dt>Éditeur</dt><dd>{editeur.nom}</dd></div>
        <div><dt>Contact</dt><dd>{editeur.contact}</dd></div>
        <div><dt>Directeur de la publication</dt><dd>{editeur.directeur_publication}</dd></div>
        <div><dt>Hébergeur</dt><dd>{editeur.hebergeur}</dd></div>
        {editeur.realisation_technique && !incomplet(editeur.realisation_technique) && (
          <div><dt>Réalisation technique</dt><dd>{editeur.realisation_technique}</dd></div>
        )}
      </dl>
    ) : (
      <p class="mesure p-incertain">
        Ces mentions ne sont pas encore renseignées. Elles le sont dans
        <code>contenu/editeur.yaml</code>, et <code>npm run publier</code> refuse
        de générer le site tant qu’elles manquent&nbsp;: cette page ne peut donc
        pas rester ainsi en production.
      </p>
    )}

    <h2 class="badge">Ce que le site sait de vous</h2>
    <p class="mesure">
      <strong>Rien qui parte d’ici.</strong> Rouages est un site statique&nbsp;:
      il n’a pas de serveur applicatif, pas de base de données, pas de compte,
      pas de formulaire, et <strong>aucune mesure d’audience</strong> — ni
      Google Analytics, ni Matomo, ni aucun équivalent. Aucun cookie n’est
      déposé.
    </p>
    <p class="mesure">
      Une seule chose est conservée, dans votre navigateur et nulle part
      ailleurs&nbsp;: <strong>la commune que vous avez choisie</strong>, pour ne
      pas avoir à la ressaisir à chaque visite. Elle est rangée dans le stockage
      local de votre navigateur, ne nous est jamais transmise, et disparaît si
      vous effacez les données du site.
    </p>
    <p class="mesure">
      <strong>S’abonner à une commune ne demande rien non plus.</strong> Chaque
      commune publie un <em>flux</em> — un fichier ordinaire, à une adresse
      fixe, que votre agrégateur va chercher comme il irait chercher une page.
      Il n’y a ni inscription, ni adresse électronique, ni liste d’abonnés&nbsp;:
      le site ne saurait pas vous écrire, et c’est voulu. Un service tiers qui
      transformerait ce flux en courriel, si vous en utilisez un, applique alors
      sa propre politique.
    </p>
    <p class="mesure">
      Deux exceptions, parce qu’elles vous emmènent ailleurs&nbsp;: signaler une
      erreur ouvre une <em>issue</em> sur GitHub, qui applique alors sa propre
      politique&nbsp;; et les liens du site mènent à des pages tierces —
      Wikipédia, Légifrance, service-public.gouv.fr — qui ont les leurs. Dans
      les deux cas, vous le voyez avant de cliquer.
    </p>
    <p class="mesure">
      Le site nomme <strong>les membres du conseil municipal</strong> — le
      maire, ses adjoints et les conseillers —, d’après le
      <strong>répertoire national des élus</strong> que l’État publie&nbsp;: leur
      nom, leur prénom, leur fonction, la date de prise de fonction des
      adjoints, leur année de naissance — jamais le jour ni le mois — et leur
      siège au conseil communautaire, rapproché sur la commune, le nom, le
      prénom et la date de naissance. Le sexe et la profession restent des
      décomptes. Les listes du scrutin municipal sont données avec la nuance
      que le ministère de l’Intérieur leur attribue, sous son libellé
      officiel.
    </p>
    <p class="mesure">
      Il nomme aussi <strong>les entreprises qui publient une annonce au
      BODACC</strong> — création, arrivée, cession de fonds, radiation —, sociétés
      comme entrepreneurs individuels, tels que le bulletin les publie, avec
      l’activité déclarée. Un entrepreneur individuel n’est nommé que si le
      répertoire SIRENE le dit diffusible&nbsp;: celui qui s’est opposé à la
      diffusion de son identité n’apparaît pas, et son statut est relu à chaque
      mise à jour. Sur la page de la commune, les procédures collectives sont
      comptées, pas nommées&nbsp;;
      les dirigeants, les adresses et les particuliers cités dans les
      délibérations ne sont pas repris.
    </p>
    <p class="mesure">
      Sur la page d’un département et d’une région, il nomme aussi
      <strong>les conseillers départementaux et régionaux, les députés et les
      sénateurs</strong>, d’après le même répertoire&nbsp;: nom, prénom,
      fonction, circonscription ou canton, année de naissance.
    </p>
    <p class="mesure">
      Pour les élus qu’il nomme, il signale <strong>leurs déclarations
      d’intérêts à la HATVP</strong> — type, statut, date, lien vers leur page
      — et reprend, tels quels, les extraits de la dernière publiée&nbsp;:
      activités, mandats, organes dirigeants, participations financières,
      fonctions bénévoles, activité du conjoint, collaborateurs, commentaires et
      montants, tout ce que la HATVP publie et rien de ce qu’elle masque — dont
      le nom du conjoint. Un conjoint ou un collaborateur peut demander le
      retrait de la ligne qui le concerne. Les déclarations publiées sont
      librement réutilisables (délibération de la HATVP n° 2017-111). Jamais
      leur déclaration de patrimoine, que la loi ne rend pas publique pour un
      élu local.
    </p>
    <p class="mesure">
      Il nomme enfin <strong>les dirigeants que les représentants d’intérêts
      déclarent à la HATVP</strong>, avec leur fonction et le lien vers la
      fiche de l’organisation : ce répertoire est tenu pour que le public sache
      qui cherche à influencer la décision publique. C’est le seul registre qui
      nomme des dirigeants d’associations&nbsp;; les autres associations ne
      sont décrites que par leur titre et leur objet.
    </p>
    <p class="mesure">
      Ces noms viennent de registres publiés pour être consultés, et chacun est
      affiché avec sa source et sa date. Une erreur se corrige par le
      <a href="/signaler">signalement</a>&nbsp;; une demande de retrait, elle,
      s’adresse à l’éditeur sans passer par une issue publique — la page de
      signalement dit comment. Le dépôt n’en garde que l’identifiant, jamais le
      nom, et l’opposition est appliquée à la mise à jour suivante.
    </p>
    <p class="mesure">
      Le site nomme aussi le <strong>titulaire de chaque marché public</strong>.
      Les données essentielles de la commande publique en donnent le SIRET, et
      le nom vient du <strong>répertoire SIRENE</strong> de l’INSEE, tel qu’il le
      publie — y compris pour un entrepreneur individuel qui exerce en nom
      propre. Chaque nom renvoie à sa fiche de l’annuaire des entreprises de
      l’État ; aucune adresse n’est reprise. Un entrepreneur qui a demandé au
      répertoire la diffusion partielle n’est pas nommé. Pour un titulaire
      nommé, les fichiers des marchés donnent aussi sa <strong>situation</strong>&nbsp;:
      le dernier jugement de procédure collective publié au BODACC dans les
      vingt-quatre derniers mois — sa nature, sa date et le lien vers
      l’annonce —, et la cessation que dit le répertoire SIRENE, sans autre
      commentaire. Pour vous opposer à
      apparaître ici, contactez l’éditeur en privé, comme indiqué sur la page
      <a href="/signaler">Signaler</a>&nbsp;; ne publiez pas cette demande dans
      une issue. L’opposition est appliquée à la mise à jour suivante des données.
    </p>
    <p class="mesure">
      Sous les <strong>installations classées et les sites et sols
      pollués</strong> de chaque commune, il nomme l’exploitant tel que
      Géorisques et le BRGM le publient, anciennes entreprises comprises, pour
      garder la trace de ce qui a été exploité là. Un entrepreneur individuel
      qui s’est opposé à la diffusion de son identité au répertoire SIRENE
      n’est pas nommé. Aucune adresse n’est reprise&nbsp;; l’opposition se fait
      comme pour les marchés, et vaut aussi sans SIRET, par le code du site.
    </p>
    <p class="mesure">
      Les fichiers nationaux des marchés donnent, pour chaque collectivité
      acheteuse, le <strong>téléphone, l’adresse électronique et le site</strong>
      de sa fiche à l’annuaire de l’administration de service-public.fr — ceux
      de la mairie ou de l’intercommunalité, pas d’un agent. Une adresse qui
      semble nommer une personne («&nbsp;prénom.nom@…&nbsp;») n’est pas reprise.
      Les <strong>avis de marché du BOAMP</strong> encore ouverts y sont
      rattachés à leur acheteur&nbsp;; le nom de la personne à contacter, que
      certains avis donnent, ne l’est pas.
    </p>
    <p class="mesure">
      Ces données sur les marchés publics servent aussi <strong>Rouages Pro</strong>
      (<a href="https://pro.rouages.fr">pro.rouages.fr</a>), le service payant du
      même éditeur&nbsp;: une veille des marchés qui arrivent à échéance, de
      ceux qui viennent d’être attribués, avec leurs titulaires, et des avis de
      marché ouverts. Il lit les
      fichiers publiés ici et ne collecte rien d’autre&nbsp;; une opposition
      appliquée ici l’est donc aussi là-bas, à la même mise à jour.
    </p>

    <h2 class="badge">Licences</h2>
    <p class="mesure">
      Le <strong>code</strong> est sous licence <a href="https://www.gnu.org/licenses/agpl-3.0.fr.html">GNU
      AGPL 3.0</a> ou ultérieure, titulaire MayetCo SAS, et ses sources sont
      publiées sur <a href={DEPOT}>GitHub</a>. Le <strong>contenu
      éditorial</strong> — acteurs, compétences, processus, flux, glossaire — est
      sous <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr">CC
      BY-SA 4.0</a>, la licence de Wikipédia&nbsp;: ce qui est écrit ici peut y
      être repris, et réciproquement.
    </p>
    <p class="mesure">
      Les <strong>données</strong> republiées ne sont pas couvertes par ces
      licences. Elles restent sous celle de leur producteur, relevée sur la
      fiche de chaque jeu et non supposée&nbsp;: {ouvertes} des {jeux.length} jeux
      sont sous <strong>Licence Ouverte</strong> d’Etalab, qui n’impose que de
      citer la source et la date de sa dernière mise à jour — c’est fait sous
      chaque bloc de chiffres.
      {nb('cc0') > 0 &&
        ` ${nb('cc0')} ${nb('cc0') > 1 ? 'sont' : 'est'} versé${nb('cc0') > 1 ? 's' : ''} au domaine public par la Commission européenne (CC0) : rien n’y est imposé, et la source est citée quand même.`}
    </p>
    {nb('odbl') > 0 && (
      <p class="mesure">
        <strong>{nb('odbl')} jeux sont sous ODbL.</strong> C’est aussi une
        licence ouverte, avec une obligation de plus&nbsp;: toute base qu’on en
        dérive se republie sous la même licence. Les fichiers de données que le
        site en tire, publiés dans <a href={DEPOT}>son dépôt</a>, sont donc sous
        ODbL&nbsp;; ils sont nommés ci-dessous, jeu par jeu, dans
        <code>public/territoires/</code> — <code>XX</code> y tient la place du
        département.
      </p>
    )}
    {(nb('variable') > 0 || nb('non-precisee') > 0) && (
      <p class="mesure">
        Deux cas restent à part, et sont dits comme tels&nbsp;: les jeux dont
        chaque publieur choisit la licence, et ceux dont la fiche n’en précise
        aucune. Le site les cite comme les autres.
      </p>
    )}

    <h2 class="badge">Les {jeux.length} jeux de données réutilisés</h2>
    <p class="mesure">
      Cette liste est celle que la veille surveille chaque semaine&nbsp;: elle ne
      peut pas se désynchroniser de ce que le site ingère réellement. Chaque jeu
      est rangé sous sa licence.
    </p>
    {parLicence.map((l) => (
      <>
        <h3 class="mentions-licence">
          {l.url ? <a href={l.url}>{l.nom}</a> : l.nom}
          <span class="mentions-usage">{` · ${l.jeux.length} jeu${l.jeux.length > 1 ? 'x' : ''}`}</span>
        </h3>
        <ul class="mentions-jeux">
          {l.jeux.map((j) => (
            <li>
              {j.lien ? <a href={j.lien.url}>{j.nom}</a> : <span>{j.nom}</span>}
              <span class="mentions-usage">alimente {j.alimente}</span>
              {j.fichiers.length > 0 && (
                <span class="mentions-usage">{`republié sous ODbL dans ${j.fichiers.join(', ')}`}</span>
              )}
            </li>
          ))}
        </ul>
      </>
    ))}

    <h2 class="badge">Responsabilité</h2>
    <p class="mesure">
      Rouages n’est <strong>ni une source de droit, ni un conseil
      juridique</strong>. Il relie des sources qui font autorité et dit d’où
      vient chaque réponse&nbsp;; c’est à ces sources qu’il faut se reporter
      pour agir. Les référentiels nationaux ont des trous, la loi change, et une
      délibération locale échappe à l’open data&nbsp;: chaque fiche porte sa date
      de vérification, et <a href="/signaler">le signalement</a> est ouvert à qui
      constate une erreur.
    </p>
  </div>
</Base>
