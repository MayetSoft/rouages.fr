---
import Base from '../../layouts/Base.astro';
import { construireReseau } from '../../modele/reseau.ts';
import { chargerGraphe, estPerime, formaterDate } from '../../modele/graphe.ts';
import { schemaVoisinage, voisinsDe } from '../../vues/voisinage.ts';
import { FAMILLES, LIBELLE_LIEN, LIBELLE_TYPE_NOEUD } from '../../modele/relations.ts';
import { construireGlossaire } from '../../modele/glossaire.ts';
import Glose from '../../composants/Glose.astro';
import { chronologie } from '../../vues/chronologie.ts';
import { fenetresAction } from '../../vues/fenetres-action.ts';
import { urlSignaler } from '../../modele/signalement.ts';

export function getStaticPaths() {
  return construireReseau().noeuds.map((n) => ({ params: { id: n.id }, props: { noeud: n } }));
}

const { noeud } = Astro.props;
const reseau = construireReseau();
const g = chargerGraphe();

const glossaire = construireGlossaire([...g.sigles.values()]);
const voisins = voisinsDe(reseau, noeud.id);
const schema = schemaVoisinage(noeud, voisins, 'voisinage', glossaire);

// Les sigles employés sur cette page, rappelés en clair sous le schéma : le
// survol ne sert à rien à l'impression, ni sur un écran tactile.
const siglesEmployes = glossaire.employes(
  [noeud.nom, noeud.resume, ...voisins.map((v) => `${v.noeud.nom} ${v.noeud.resume}`)].join(' '),
);

// Un processus est la seule chose qu'un graphe ne sait pas montrer : le temps.
const processus = g.processus.get(noeud.id);
const frise = processus ? chronologie(g, processus) : null;
const fenetres = processus ? fenetresAction(processus) : null;

const source = g.acteurs.get(noeud.id) ?? g.competences.get(noeud.id) ?? g.processus.get(noeud.id);
const perime = source && 'perime_apres_mois' in source ? estPerime(source) : false;

const ORDRE_LIENS = ['wikipedia', 'droit', 'page_officielle', 'donnees_ouvertes', 'etude', 'presse'];
const groupes = ORDRE_LIENS.map((type) => ({
  type,
  liste: noeud.liens.filter((l) => l.type === type),
})).filter((gr) => gr.liste.length > 0);
---

<Base titre={noeud.nom} description={noeud.resume || noeud.nom} section="fonctionnement">
  <div class="page">
    <p class="badge">
      {LIBELLE_TYPE_NOEUD[noeud.type]}
      {noeud.confiance !== 'etabli' && (
        <span class="badge--alerte">
          {' · '}
          {noeud.confiance === 'variable_selon_territoire' ? 'varie selon le territoire' : 'à confirmer'}
        </span>
      )}
      {perime && <span class="badge--alerte">{' · '}à revérifier</span>}
    </p>
    <h1><Glose texte={noeud.nom} /></h1>
    {noeud.resume && <p class="resume"><Glose texte={noeud.resume} /></p>}

    <h2 class="badge">Pour en savoir plus</h2>
    <div class="grille-liens">
      {groupes.map((gr) => (
        <section>
          <h2>{LIBELLE_LIEN[gr.type]}</h2>
          <ul>
            {gr.liste.map((l) => (
              <li><a href={l.url} rel="noopener nofollow" target="_blank">{l.titre}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <h2 class="badge">{voisins.length} relations</h2>
    <div class="cadre-schema" set:html={schema.svg} />
    <p class="indice-defilement">Le schéma défile horizontalement.</p>

    {/* La légende accompagne toujours le schéma : la couleur seule ne dit rien. */}
    <ul class="legende-fixe">
      {FAMILLES.filter((f) => voisins.some((v) => v.fam === f.id)).map((f) => (
        <li>
          <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
            <line class={`cle-trait cle-trait--${f.id}`} x1="1" y1="5" x2="23" y2="5" stroke-dasharray={f.tirets} />
          </svg>
          <strong>{f.libelle}</strong> <span class="v-nature">{f.aide}</span>
        </li>
      ))}
    </ul>

    {siglesEmployes.length > 0 && (
      <dl class="sigles">
        {siglesEmployes.map((s) => (
          <div>
            <dt>{s.sigle}</dt>
            <dd>{s.developpe}{s.definition ? ` — ${s.definition}` : ''}{s.noeud && s.noeud !== noeud.id ? <> · <a href={`/n/${s.noeud}`}>sa fiche</a></> : null}</dd>
          </div>
        ))}
      </dl>
    )}

    <ul class="relations">
      {voisins.map((v) => (
        <li>
          <span class={`p-cle p-cle--${v.fam}`}></span>
          <span class="quoi">{v.label}</span>
          <span>
            <a href={`/n/${v.noeud.id}`}><Glose texte={v.noeud.nom} /></a>{' '}
            <span class="v-nature"><Glose texte={v.noeud.resume} /></span>
          </span>
        </li>
      ))}
    </ul>

    {fenetres && (
      <section>
        <h2 class="badge">{fenetres.titre}</h2>
        <div class="cadre-schema" set:html={fenetres.svg} />
        <details class="equivalent"><summary>Le même en tableau</summary><div set:html={fenetres.tableau} /></details>
      </section>
    )}

    {frise && (
      <section>
        <h2 class="badge">{frise.titre}</h2>
        <div class="cadre-schema" set:html={frise.svg} />
        <details class="equivalent"><summary>Le même en tableau</summary><div set:html={frise.tableau} /></details>
      </section>
    )}

    {source && 'verifie_le' in source && (
      <p class="v-nature">Vérifié le {formaterDate(source.verifie_le)}.</p>
    )}
    <p><a href={`/fonctionnement#${noeud.id}`}>Voir ce nœud dans la carte</a></p>
    <p class="p-signaler">
      <a href={urlSignaler(noeud.id)}>Signaler une erreur sur cette fiche</a>
    </p>
  </div>
</Base>
