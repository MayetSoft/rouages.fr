    {vie.antennes && (
      <section id="mobile">
        <h2 class="badge">Les antennes de téléphonie mobile</h2>
        <Antennes a={vie.antennes} />
      </section>
    )}

    {vie.production && (
      <section id="production">
        <h2 class="badge">L’électricité produite sur la commune</h2>
        <Production p={vie.production} />
      </section>
    )}

    {vie.monuments && (
      <section id="monuments">
        <h2 class="badge">Les monuments historiques</h2>
        <Monuments m={vie.monuments} />
      </section>
    )}

    {vie.lieux && (
      <section id="a-voir">
        <h2 class="badge">À voir</h2>
        <Lieux l={vie.lieux} />
      </section>
    )}

    {vie.delinquance && (
      <section id="securite">
        <h2 class="badge">La délinquance enregistrée</h2>
        <Delinquance d={vie.delinquance} depNom={SEULE_DE_SON_DEPARTEMENT.has(commune.code) ? null : commune.depNom} />
      </section>
    )}

    {vie.route && (
      <section id="route">
        <h2 class="badge">Les accidents de la route</h2>
        <Route r={vie.route} />
      </section>
    )}

    {vie.gares && (
      <section id="gares">
        <h2 class="badge">Prendre le train</h2>
        <Gares g={vie.gares} />
      </section>
    )}

    {vie.recharge && (
      <section id="recharge">
        <h2 class="badge">Recharger, covoiturer</h2>
        <Recharge r={vie.recharge} />
      </section>
    )}

    {vie.agriculture && (
      <section id="agriculture">
        <h2 class="badge">Sa surface agricole</h2>
        <Agriculture a={vie.agriculture} />
      </section>
    )}

    {vie.appellations && (
      <section id="appellations">
        <h2 class="badge">Les appellations d’origine</h2>
        <Appellations a={vie.appellations} />
      </section>
    )}

    {journal.length > 0 && (
      <section id="journal" class="releve">
        <h2 class="badge">Ce qui a bougé récemment</h2>
        <p class="mesure">
          Les six derniers faits datés — ici et dans les structures dont la commune dépend,
          qui agissent le plus souvent pour elle.
          {' '}<a href={`/commune/${commune.code}-flux.xml`}>S’abonner au flux</a>, pour le
          recevoir dans un agrégateur. Le site ne demande aucune adresse et n’en conserve aucune.
        </p>
        <ul class="journal" data-commune={commune.code}>
          {journal.map((e) => (
            <li data-date={e.date}>
              <span class="journal-date">{e.date}</span>
              <span class="journal-fait">
                <span class="journal-genre">{e.genre}</span>
                {e.url ? <a href={e.url}>{e.quoi}</a> : <span>{e.quoi}</span>}
                {(e.par || e.detail) && (
                  <span class="journal-detail">{[e.par, e.detail].filter(Boolean).join(' · ')}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
        <p class="p-source-territoire">
          Le journal ne dit pas tout&nbsp;: un transfert de compétence n’y figure pas, parce que
          le registre BANATIC ne le date pas. Un acte publié tardivement s’y range à sa date, pas
          à celle de sa publication.
        </p>
      </section>
    )}

    <script>
      // Sans effet quand la commune n'a pas de journal : le script cherche la liste et s'arrête.
      import '../../client/derniere-visite.ts';
    </script>

    <h2 class="badge">Aller plus loin</h2>
    <ul>
      <li>
        <a href={`/?commune=${commune.code}`}>Voir cette commune sur la carte</a> — chaque
        compétence y montre qui l’exerce ici, parmi tous les acteurs qui la partagent.
      </li>
      {fiche?.soumiseSru && (
        <li><a href="/n/logement-social">L’obligation de logements sociaux</a> s’applique ici.</li>
      )}
      {fiche?.risques && (
        <li><a href="/n/s-informer-sur-les-risques">S’informer sur les risques de son adresse</a> — ce
        qu’un vendeur doit dire, et ce qui s’ouvre après un arrêté de catastrophe naturelle.</li>
      )}
      <li><a href="/methode">Comment ces réponses sont construites</a></li>
      <li><a href={urlSignaler(undefined, commune.code, `/commune/${commune.code}`)}>Signaler une erreur sur cette commune</a></li>
    </ul>
  </div>
</Base>
