        <Demarches bloc="comptes" />
        <ChambreComptes codeRegion={meta?.codesRegion?.[commune.dep]} nom={commune.nom} />
      </section>
    )}

    {vie.dotations && (
      <section id="dotations" class="p-finances">
        <h2 class="badge">Ce que l’État lui verse</h2>
