---
/**
 * La page d'une commune.
 *
 * Tout ce que le site sait d'une commune est ici, et seulement ici. Le panneau
 * de la carte en portait longtemps davantage — les comptes, l'élection, les
 * marchés, les délibérations, les associations — pendant que la page renvoyait
 * vers lui. Deux programmes décrivaient la même commune, et ils avaient dérivé :
 * une faute d'accord corrigée ici restait là-bas, un document d'urbanisme
 * ajouté ici n'y arrivait jamais. La carte montre maintenant qui exerce chaque
 * compétence, là où la question se pose, et conduit ici pour le reste.
 *
 * Le poids a été le seul argument contre, parce que ce qu'on ajoute se
 * multiplie par 34 875 pages. Il se mesure plutôt qu'il ne s'estime : les
 * courbes sont des SVG de quelques centaines d'octets, les listes sont bornées
 * à ce que le panneau montrait déjà, et la suite des marchés reste dans son
 * propre fichier, chargé à la demande.
 */
import Base from '../../layouts/Base.astro';
import { construireReseau } from '../../modele/reseau.ts';
import {
  communes,
  ficheCommune,
  intercommunalite,
  journalCommune,
  lienIntercommunalite,
  metaTerritoires,
} from '../../modele/territoires.ts';
import type { Verdict } from '../../modele/verdict.ts';
import { urlSignaler } from '../../modele/signalement.ts';
import Glose from '../../composants/Glose.astro';
import { ARTICLE_DOCUMENT, enFrancais, NOM_DOCUMENT } from '../../modele/urbanisme.ts';
import { complementsFiche } from '../../modele/fiche-commune.ts';
import { moisAnnee } from '../../vues/graphiques.ts';
import Habitants from '../../composants/commune/Habitants.astro';
import NiveauDeVie from '../../composants/commune/NiveauDeVie.astro';
import Diplomes from '../../composants/commune/Diplomes.astro';
import Scrutin from '../../composants/commune/Scrutin.astro';
import Conseil from '../../composants/commune/Conseil.astro';
import Comptes from '../../composants/commune/Comptes.astro';
import FluxPercus from '../../composants/commune/FluxPercus.astro';
import Echelons from '../../composants/commune/Echelons.astro';
import Dmto from '../../composants/commune/Dmto.astro';
import Sru from '../../composants/commune/Sru.astro';
import Marches from '../../composants/commune/Marches.astro';
import Deliberations from '../../composants/commune/Deliberations.astro';
import Subventions from '../../composants/commune/Subventions.astro';
import Associations from '../../composants/commune/Associations.astro';
import CentresSociaux from '../../composants/commune/CentresSociaux.astro';
import Entreprises from '../../composants/commune/Entreprises.astro';
import EntreprisesPresentes from '../../composants/commune/EntreprisesPresentes.astro';
import Essentiel from '../../composants/commune/Essentiel.astro';
import Demarches from '../../composants/commune/Demarches.astro';
import Fiscalite from '../../composants/commune/Fiscalite.astro';
import Logements from '../../composants/commune/Logements.astro';
import Equipements from '../../composants/commune/Equipements.astro';
import Services from '../../composants/commune/Services.astro';
import Emploi from '../../composants/commune/Emploi.astro';
import Logement from '../../composants/commune/Logement.astro';
import Sante from '../../composants/commune/Sante.astro';
import Ecoles from '../../composants/commune/Ecoles.astro';
import Reseaux from '../../composants/commune/Reseaux.astro';
import Delinquance from '../../composants/commune/Delinquance.astro';
import Agriculture from '../../composants/commune/Agriculture.astro';
import Votes from '../../composants/commune/Votes.astro';
import Sols from '../../composants/commune/Sols.astro';
import ChambreComptes from '../../composants/ChambreComptes.astro';
import Dpe from '../../composants/commune/Dpe.astro';
import Dotations from '../../composants/commune/Dotations.astro';
import Caf from '../../composants/commune/Caf.astro';
import Defibrillateurs from '../../composants/commune/Defibrillateurs.astro';
import Route from '../../composants/commune/Route.astro';
import Gares from '../../composants/commune/Gares.astro';
import Antennes from '../../composants/commune/Antennes.astro';
import Zonages from '../../composants/commune/Zonages.astro';
import Investissement from '../../composants/commune/Investissement.astro';
import Loyers from '../../composants/commune/Loyers.astro';
import Recharge from '../../composants/commune/Recharge.astro';
import PetiteEnfance from '../../composants/commune/PetiteEnfance.astro';
import Travail from '../../composants/commune/Travail.astro';
import Appellations from '../../composants/commune/Appellations.astro';
import Secheresse from '../../composants/commune/Secheresse.astro';
import CarteSituation from '../../composants/commune/CarteSituation.astro';
import { carteDeSituation, espacesNaturels } from '../../modele/carte.ts';
import EspacesNaturels from '../../composants/commune/EspacesNaturels.astro';
import Production from '../../composants/commune/Production.astro';
import Monuments from '../../composants/commune/Monuments.astro';
import Lieux from '../../composants/commune/Lieux.astro';
import { complementsVie } from '../../modele/fiche-vie.ts';

export function getStaticPaths() {
  // `ROUAGES_DEPS` restreint la génération à quelques départements : engendrer
  // les 34 875 communes prend plusieurs minutes, et on ne veut pas les payer à
  // chaque essai de mise en page.
  const filtre = process.env.ROUAGES_DEPS?.split(',').map((d) => d.trim()).filter(Boolean);
  const liste = communes().filter((c) => !filtre || filtre.includes(c.dep));
  return liste.map((c) => ({ params: { code: c.code }, props: { commune: c } }));
}

const { commune } = Astro.props;
const reseau = construireReseau();
const meta = metaTerritoires();

// Le contenu décide de ce qu'on cherche à savoir : on résout les compétences
// que le réseau déclare résolubles, pas tous les codes du référentiel.
const resolubles = reseau.noeuds
  .filter((n) => n.banatic && n.banatic.length > 0)
  .map((n) => ({ id: n.id, banatic: n.banatic! }));
const fiche = ficheCommune(commune, resolubles);
const plus = complementsFiche(commune, commune.population, fiche?.structures ?? []);
const vie = complementsVie(commune);
const carte = carteDeSituation(commune);
const espaces = espacesNaturels(commune);

const nomDe = new Map(reseau.noeuds.map((n) => [n.id, n]));
/**
 * Le verdict en deux morceaux : qui, et une incise qui dit d'où vient la
 * réponse.
 *
 * La nature juridique de chaque structure n'est pas répétée ici : elle figure
 * une fois, plus haut, dans la liste des structures. La redire à chaque ligne
 * alourdissait la page d'un bon kilo-octet — multiplié par 34 875 — pour une
 * information déjà donnée.
 */
function direVerdict(v: Verdict): { qui: string; incise: string | null; etat: string } {
  switch (v.etat) {
    case 'transferee':
      return { qui: v.structures.map((s) => s.nom).join(' · '), incise: null, etat: v.etat };
    case 'transferee-par-loi':
      return {
        qui: v.structures.map((s) => s.nom).join(' · '),
        incise: 'transfert prévu de plein droit par la loi',
        etat: v.etat,
      };
    case 'a-defaut':
      return { qui: v.qui, incise: "à défaut d'intercommunalité, par la loi", etat: v.etat };
    case 'communale':
      return { qui: 'la commune', incise: 'aucun transfert enregistré', etat: v.etat };
    case 'non-renseigne':
      return {
        qui: 'non renseigné ici',
        incise:
          `${Math.round(v.couvertureDep * 100)} % des communes du département ont un exerçant ` +
          `identifié, contre ${Math.round(v.couvertureNationale * 100)} % en France`,
        etat: v.etat,
      };
  }
}

const lignes = fiche
  ? [...fiche.verdicts.entries()]
      .map(([id, v]) => ({
        noeud: nomDe.get(id)!,
        dit: direVerdict(v),
        reserve: fiche.reserve(id),
      }))
      .filter((l) => l.noeud)
      .sort((a, b) => a.noeud.nom.localeCompare(b.noeud.nom, 'fr'))
  : [];

/**
 * Qui écrit la règle de ce qui peut se construire, en une phrase.
 *
 * Trois situations, qui n'ont pas les mêmes conséquences pour un habitant :
 * un plan voté par le conseil municipal, un plan voté ailleurs, ou pas de
 * plan du tout — auquel cas le préfet donne son accord sur chaque permis.
 */
const urb = fiche?.urbanisme ?? null;
const phraseUrbanisme = !urb
  ? ''
  : urb.document === 'RNU'
    ? 'Aucun document d’urbanisme local : c’est le règlement national d’urbanisme qui s’applique ' +
      'ici. Une construction n’y est en principe autorisée que dans les parties déjà urbanisées ' +
      'de la commune (article L111-3 du code de l’urbanisme), et le maire ne peut délivrer un ' +
      'permis qu’avec l’accord du préfet — un avis conforme, c’est-à-dire qu’un avis défavorable ' +
      'l’interdit (article L422-5).'
    : (() => {
        // « Une carte communale, approuvé […] Il est voté » : le seul document
        // féminin de la liste tombait dans des phrases écrites au masculin.
        // L'article porte déjà le genre, autant s'en servir.
        const f = ARTICLE_DOCUMENT[urb.document] === 'une';
        const il = f ? 'Elle' : 'Il';
        return (
          `La commune est couverte par ${ARTICLE_DOCUMENT[urb.document] ?? 'un'} ` +
          `${NOM_DOCUMENT[urb.document] ?? urb.document}` +
          (urb.approuve ? `, approuvé${f ? 'e' : ''} le ${enFrancais(urb.approuve)}` : '') +
          '. ' +
          (urb.qui === 'groupement'
            ? urb.porteur
              ? `${il} est porté${f ? 'e' : ''} par ${urb.porteur} : ses règles sont votées par ` +
                `le conseil de ce groupement, non par le conseil municipal.`
              : `${il} est porté${f ? 'e' : ''} par l’intercommunalité, non par le conseil ` +
                'municipal.'
            : urb.qui === 'transferee'
              ? `${f ? 'Cette carte' : 'Ce plan'} ne couvre que la commune, mais la compétence ` +
                `en urbanisme appartient désormais à ${urb.porteur ?? 'son intercommunalité'} : ` +
                `c’est son conseil qui en votera la révision.`
              : `${il} est voté${f ? 'e' : ''} par le conseil municipal.`)
        );
      })();

const equ = fiche?.equipements ?? null;
const fisc = fiche?.fiscalite ?? null;
const log = fiche?.logements ?? null;

/**
 * Ce qui a bougé, en six lignes.
 *
 * Six et non douze : ce qu'on ajoute à cette page se multiplie par 34 875,
 * et la suite est dans le flux. La section pèse
 * alors deux kilo-octets au lieu de quatre, soit soixante-dix méga-octets de
 * moins sur le site entier.
 */
const journal = journalCommune(commune, 6);
// Tout le journal de la fenêtre, pour le compter dans l'essentiel : la page n'en montre que six.
const PLAFOND_JOURNAL = 40;
const faits = journalCommune(commune, PLAFOND_JOURNAL).length;

const region = meta?.regions?.[commune.dep];
const titre = `${commune.nom} — qui décide quoi`;
const description = fiche
  ? `Qui exerce chaque compétence à ${commune.nom} (${commune.cp}) : intercommunalité, ` +
    `syndicats, commune. Comptes, élection, marchés publics, écoles et services, avec leurs sources.`
  : `${commune.nom} (${commune.cp})`;

/**
 * Les droits de mutation : le dernier exercice que le département renseigne.
 * Sans lui, le bloc n'a rien à dire.
 */
const dmtoDernier = plus.dmto
  ? plus.dmto.departement.reduce<number>((k, v, i) => (v !== null ? i : k), -1)
  : -1;

/**
 * En Alsace-Moselle, une association ne se déclare pas en préfecture : elle
 * s'inscrit au registre tenu par le greffe du tribunal judiciaire. Le
 * répertoire national n'y sait rien, et le dire vaut mieux qu'un bloc absent.
 */
const DROIT_LOCAL = new Set(['57', '67', '68']);

/** Filosofi 2023 ne publie rien pour ces quatre départements : le dire plutôt qu'un bloc absent. */
const SANS_FILOSOFI = new Set(['971', '972', '973', '976']);

/** Paris est à la fois commune et département : ses chiffres ne se comparent pas à eux-mêmes. */
const SEULE_DE_SON_DEPARTEMENT = new Set(['75056']);
const droitLocal = DROIT_LOCAL.has(commune.dep) && !(plus.associations && plus.associations.total > 0);

/**
 * Le sommaire : la page d'une grande commune dépasse les dix écrans, et rien
 * ne disait ce qui restait à venir. L'étiquette n'est pas le titre du bloc :
 * « Une vente immobilière » tient dans une pastille, « Ce que rapporte une
 * vente immobilière » non.
 */
const echelonsMontres = plus.echelons.length > 0;
const risquesGaspar = !!fiche?.risques && (fiche.risques.recenses.length > 0 || fiche.risques.catnat.length > 0);
const risquesMontres = risquesGaspar || !!vie.radon;
const ZONES_RADON = ['', 'potentiel faible', 'potentiel faible, mais des facteurs géologiques peuvent faciliter son passage dans les bâtiments', 'potentiel significatif'];
const sommaire: [string, string, unknown][] = [
  ['habitants', 'Les habitants', plus.histoire || plus.etatCivil || plus.ages],
  ['niveaux', 'Revenus, emploi, diplômes', plus.niveauDeVie || plus.diplomes || vie.emploi],
  ['election', 'L’élection', plus.scrutin],
  ['conseil', 'Le conseil', fiche?.conseil && fiche.conseil.elus > 0],
  ['votes', 'Les votes nationaux', vie.votes],
  ['qui-exerce', 'Qui exerce quoi', lignes.length > 0],
  ['comptes', 'Ses comptes', plus.finances],
  ['dotations', 'Les dotations de l’État', vie.dotations],
  ['investissement', 'Les projets subventionnés', vie.investissement],
  ['ccas', 'Le CCAS', plus.centres],
  ['caf', 'Les allocataires de la CAF', vie.caf],
  ['preleve', 'Ce qui est prélevé ici', fiche?.fiscalite],
  ['intercommunalite', 'L’intercommunalité', plus.fluxPercus.length > 0],
  ['echelons', 'Les échelons', echelonsMontres],
  ['zonages', 'Programmes et zonages', vie.zonages],
  ['logements', 'Les logements', vie.parc || vie.immobilier],
  ['loyers', 'Les loyers', vie.loyers],
  ['dpe', 'Les étiquettes énergétiques', vie.dpe],
  ['vente', 'Une vente immobilière', dmtoDernier >= 0],
  ['urbanisme', 'Ce qui peut s’y construire', fiche?.urbanisme],
  ['construit', 'Ce qui s’y construit', fiche?.logements],
  ['sols', 'Les sols consommés', vie.artificialisation],
  ['risques', 'Les risques', risquesMontres],
  ['logement-social', 'Le logement social', plus.sru],
  ['marches', 'Les marchés', plus.marches.length > 0],
  ['deliberations', 'Les délibérations', plus.deliberations.length > 0],
  ['subventions', 'Les subventions', plus.subventions.length > 0],
  ['associations', 'Les associations', (plus.associations && plus.associations.total > 0) || droitLocal],
  ['entreprises', 'Les entreprises', plus.presentes || plus.entreprises],
  ['travail', 'Le travail', vie.travail],
  ['equipements', 'Ce qu’on trouve sur place', fiche?.equipements],
  ['services', 'Les services', (fiche?.services.length ?? 0) > 0],
  ['sante', 'Le médecin', vie.sante],
  ['defibrillateurs', 'Les défibrillateurs', vie.defibrillateurs],
  ['petite-enfance', 'Les tout-petits', vie.petiteEnfance],
  ['ecoles', 'Les écoles', vie.ecoles],
  ['reseaux', 'Eau, fibre, énergie', vie.eau || vie.fibre || vie.energie],
  ['secheresse', 'Les restrictions d’eau', vie.secheresse],
  ['nature', 'Les espaces naturels', espaces],
  ['mobile', 'Les antennes mobiles', vie.antennes],
  ['production', 'L’électricité produite', vie.production],
  ['monuments', 'Les monuments historiques', vie.monuments],
  ['a-voir', 'À voir', vie.lieux],
  ['securite', 'La délinquance', vie.delinquance],
  ['route', 'Les accidents de la route', vie.route],
  ['gares', 'Le train', vie.gares],
  ['recharge', 'Recharge et covoiturage', vie.recharge],
  ['agriculture', 'L’agriculture', vie.agriculture],
  ['appellations', 'Les appellations', vie.appellations],
  ['journal', 'Ce qui a bougé', journal.length > 0],
];
const entrees = sommaire.filter(([, , present]) => !!present);
const eau = plus.eau && plus.eau.prix !== null ? plus.eau : null;
---

<Base
  titre={titre}
  description={description}
  flux={journal.length > 0 ? `/commune/${commune.code}-flux.xml` : undefined}
  section="chez-moi"
>
  <div class="page page--etroite">
    <p class="badge">Commune · {commune.depNom}{region ? ` · ${region}` : ''}</p>
    <h1>{commune.nom}</h1>
    <p class="resume">
      {commune.population.toLocaleString('fr-FR')} habitants · code postal {commune.cp} ·
      code INSEE {commune.code} ·{' '}
      <a href={`/comparer?a=${commune.code}`}>la comparer à une autre</a>
    </p>
    {!fiche && (
      <p class="c-vide">
        Les données territoriales de cette commune n’ont pas pu être assemblées.
        La carte reste le meilleur endroit d’où repartir.
      </p>
    )}

    {fiche?.maire && (
      <p class="p-maire">
        <span class="p-maire-fonction">Maire</span>
        <span class="p-maire-nom">{fiche.maire.prenom} {fiche.maire.nom}</span>
        {moisAnnee(fiche.maire.depuis) && (
          <span class="p-maire-depuis">mandat en cours depuis {moisAnnee(fiche.maire.depuis)}</span>
        )}
      </p>
    )}

    {fiche?.maire && (
      <p class="p-source-territoire c-maire-source">
        Le maire vient du répertoire national des élus ({fiche.maire.maj}).
      </p>
    )}

    {carte && <CarteSituation carte={carte} nom={commune.nom} depNom={commune.depNom} />}

    <Essentiel plus={plus} vie={vie} population={commune.population} faits={faits} plafond={PLAFOND_JOURNAL} />

    {entrees.length > 1 && (
      <nav class="p-sommaire c-sommaire" aria-label="Les blocs de cette commune">
        {entrees.map(([id, etiquette]) => <a class="p-sommaire-lien" href={`#${id}`}>{etiquette}</a>)}
      </nav>
    )}

    {(plus.histoire || plus.etatCivil || plus.ages) && (
      <section id="habitants" class="p-habitants">
        <h2 class="badge">Combien d’habitants</h2>
        <Habitants h={plus.histoire} ec={plus.etatCivil} ag={plus.ages} />
        <Demarches bloc="habitants" />
      </section>
    )}

    {(plus.niveauDeVie || plus.diplomes || vie.emploi) && (
      <section id="niveaux" class="p-habitants">
        <h2 class="badge">De quoi ils vivent, ce qu’ils ont étudié</h2>
        {plus.niveauDeVie && <NiveauDeVie n={plus.niveauDeVie} depNom={SEULE_DE_SON_DEPARTEMENT.has(commune.code) ? null : commune.depNom} />}
        {!plus.niveauDeVie && SANS_FILOSOFI.has(commune.dep) && (
          <p class="p-strate">
            Le niveau de vie n’est pas publié ici : pour le millésime 2023, l’INSEE ne diffuse aucun chiffre
            de revenus en Guadeloupe, en Martinique, en Guyane ni à Mayotte.
          </p>
        )}
        {vie.emploi && <Emploi e={vie.emploi} depNom={SEULE_DE_SON_DEPARTEMENT.has(commune.code) ? null : commune.depNom} />}
        {plus.diplomes && <Diplomes d={plus.diplomes} seule={SEULE_DE_SON_DEPARTEMENT.has(commune.code)} />}
      </section>
    )}

    {plus.scrutin && (
      <section id="election" class="p-scrutin">
        <h2 class="badge">{`Comment le conseil a été élu — ${plus.scrutin.nom}`}</h2>
        <Scrutin sc={plus.scrutin}>
          {fiche?.conseil && fiche.conseil.sieges > 0 && (
            <p class="p-scrutin-sieges">
              {`${fiche.conseil.sieges} sièges au conseil municipal`}{fiche.conseil.siegesCc > 0 && (
                <>{`, ${fiche.conseil.siegesCc} au conseil `}{fiche.conseil.ou
                  ? <Glose texte={`de ${fiche.conseil.ou}`} />
                  : <>communautaire</>}</>
              )}.
            </p>
          )}
          {fiche?.conseil?.designes && fiche.conseil.ou && (
            <p class="p-scrutin-designes">
              Au conseil de <Glose texte={fiche.conseil.ou} />, la commune n’élit pas ses
              représentants&nbsp;: sous mille habitants, ce sont les conseillers municipaux pris
              dans l’ordre du tableau — le maire, puis les adjoints (article L273-11 du code
              électoral). Le résultat du scrutin ne les nomme donc pas.
            </p>
          )}
        </Scrutin>
        <Demarches bloc="election" />
      </section>
    )}

    {fiche?.conseil && fiche.conseil.elus > 0 && (
      <section id="conseil" class="p-conseil">
        <h2 class="badge">De quoi le conseil est fait</h2>
        <Conseil k={fiche.conseil} />
      </section>
    )}

    {vie.votes && (
      <section id="votes" class="p-scrutin">
        <h2 class="badge">Comment la commune vote aux élections nationales</h2>
        <Votes scrutins={vie.votes.scrutins} resultats={vie.votes.resultats} voix={vie.votes.voix} maj={vie.votes.maj} />
      </section>
    )}

    {fiche && fiche.structures.length > 0 && (
      <section id="qui-exerce">
        <h2 class="badge">Les structures dont elle dépend</h2>
        <ul class="c-structures">
          {fiche.structures.map((s) => (
            <li>
              <strong>
                {intercommunalite(s.siren) ? (
                  <a href={lienIntercommunalite(s.siren)}><Glose texte={s.nom} /></a>
                ) : (
                  <Glose texte={s.nom} />
                )}
              </strong>
              <span class="v-nature">{s.natureLibelle}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {lignes.length > 0 && (
      <section>
        <h2 class="badge">Qui exerce quoi, ici</h2>
        <dl class="c-verdicts">
          {lignes.map((l) => (
            <div>
              <dt><a href={`/n/${l.noeud.id}`}><Glose texte={l.noeud.court} /></a></dt>
              <dd>
                <span class={`c-verdict c-verdict--${l.dit.etat}`}><Glose texte={l.dit.qui} /></span>
                {l.dit.incise && <span class="c-incise">{l.dit.incise}</span>}
                {l.reserve && <span class="c-reserve">{l.reserve}</span>}
                {eau && eau.competence === l.noeud.id && (
                  // Le prix de l'eau n'a de sens qu'attaché au service qui la
                  // distribue : c'est le même mètre cube, mais ni le même
                  // exploitant ni le même tarif d'une commune à l'autre.
                  <span class="p-prix-eau">
                    <span class="p-prix">{`${eau.prix!.toLocaleString('fr-FR')} € / m³`}</span>
                    <span class="p-prix-detail">
                      {`TTC en ${eau.annee}, pour 120 m³ · médiane nationale ${eau.median?.toLocaleString('fr-FR')} €` +
                        (eau.gestion ? ` · ${eau.gestion.toLowerCase()}` : '') +
                        (eau.operateur ? ` (${eau.operateur})` : '')}
                    </span>
                  </span>
                )}
              </dd>
            </div>
          ))}
        </dl>
        <p class="p-source-territoire">
          D’après les transferts de compétences déclarés à BANATIC ({fiche!.maj}). Une compétence
          exercée sans transfert déclaré — par convention, par exemple — n’y figure pas.
        </p>
      </section>
    )}

    {plus.finances && (
      <section id="comptes" class="p-finances">
        <h2 class="badge">{`Ses comptes, en ${plus.finances.annee}`}</h2>
