      </section>
    )}

    {vie.secheresse && (
      <section id="secheresse">
        <h2 class="badge">Les restrictions d’eau pour sécheresse</h2>
        <Secheresse s={vie.secheresse} />
      </section>
    )}

    {espaces && (
      <section id="nature">
        <h2 class="badge">Les espaces naturels</h2>
        <EspacesNaturels e={espaces} nom={commune.nom} />
      </section>
