    {vie.artificialisation && (
      <section id="sols">
        <h2 class="badge">Les terres naturelles, agricoles et forestières consommées</h2>
        <Sols a={vie.artificialisation} />
      </section>
    )}

    {risquesMontres && (
      <section id="risques">
        <h2 class="badge">À quoi la commune est exposée</h2>
        {fiche?.risques && fiche.risques.recenses.length > 0 && (
          <p class="mesure">
            <strong>Recensés au dossier départemental</strong>&nbsp;:
            {' '}{fiche.risques.recenses
              .map((r) => (r.sous.length > 0 ? `${r.nom} (${r.sous.map((x) => x.charAt(0).toLowerCase() + x.slice(1)).join(', ')})` : r.nom))
              .join(', ')}.
          </p>
        )}
        {fiche?.risques && fiche.risques.catnat.length > 0 && (
          <p class="mesure">
            <strong>Reconnaissances de catastrophe naturelle depuis 1982</strong>&nbsp;:
            {' '}{fiche.risques.catnat
              .map((c) => {
                // « dernier en » n'a de sens qu'au-delà d'un arrêté : sinon
                // c'est le seul, et « dernier » laisserait croire à une série.
                const quand = c.dernier ? `${c.nombre > 1 ? ', dernier en ' : ', en '}${c.dernier.slice(0, 4)}` : '';
                return `${c.nom.toLowerCase()} (${c.nombre}${quand})`;
              })
              .join(', ')}.
          </p>
        )}
        {fiche?.risques && fiche.risques.plans.length > 0 && (
          <p class="mesure">
            <strong>Plans de prévention</strong>&nbsp;:
            {' '}{fiche.risques.plans
              .map((p) => `${p.nom}${p.etat ? ` (${p.etat.toLowerCase()}${p.date ? `, ${p.date.slice(0, 4)}` : ''})` : ''}`)
              .join(' ; ')}.
          </p>
        )}
        {vie.radon && (
          <p class="mesure">
            <strong>Radon</strong>&nbsp;:
            {vie.radon.zones.length === 1
              ? ` zone ${vie.radon.zones[0]} sur 3, ${ZONES_RADON[vie.radon.zones[0]]}.`
              : ` zones ${vie.radon.zones.join(' et ')} sur 3, selon les communes qui l’ont formée.`}
            {vie.radon.zones.includes(3) &&
              ' Le vendeur ou le bailleur d’un logement situé en zone 3 doit en informer l’acquéreur ou le locataire.'}
          </p>
        )}
        {vie.radon && (
          <p class="p-source-territoire">
            Le radon est un gaz radioactif d’origine naturelle, qui vient du sol. L’arrêté du 27 juin 2018 range chaque
            commune dans l’une de trois zones, d’après le potentiel de ses sols&nbsp;; le zonage est celui des communes
            au 1er janvier 2016, publié par l’Autorité de sûreté nucléaire{vie.radon.publie ? ` en ${vie.radon.publie}` : ''}.
          </p>
        )}
        {fiche?.risques && risquesGaspar && (
        <p class="p-source-territoire">
          D’après GASPAR, la base du ministère de la Transition écologique ({fiche.risques.maj}).
          Les risques recensés et les catastrophes reconnues sont deux listes distinctes&nbsp;: la
          première dit ce à quoi l’État estime la commune exposée, la seconde ce qui est arrivé.
          {fiche.risques.dicrim
            ? ` Document d’information communal publié en ${fiche.risques.dicrim}.`
            : ' Aucun document d’information communal recensé.'}
        </p>
        )}
      </section>
    )}

    {plus.sru && (
      <section id="logement-social" class="p-sru">
        <h2 class="badge">Logement social : ce que la loi exige</h2>
        <Sru s={plus.sru} maj={plus.sruMaj} />
        <Demarches bloc="logement-social" />
      </section>
    )}

    {plus.marches.length > 0 && (
      <section id="marches" class="p-marches">
        <h2 class="badge">Ce qui est commandé</h2>
        <Marches liste={plus.marches} depuis={plus.marchesDepuis} fenetre={plus.marchesFenetre} procedures={plus.marchesProcedures} />
      </section>
    )}

    {plus.deliberations.length > 0 && (
      <section id="deliberations" class="p-marches p-delibs">
        <h2 class="badge">Ce qui a été délibéré</h2>
        <Deliberations liste={plus.deliberations} depuis={plus.delibDepuis} />
        <Demarches bloc="deliberations" />
      </section>
    )}

    {plus.subventions.length > 0 && (
      <section id="subventions" class="p-marches p-subventions">
        <h2 class="badge">Ce qui est versé aux associations</h2>
        <Subventions liste={plus.subventions} seuil={plus.subventionsSeuil} />
      </section>
    )}

    {plus.associations && plus.associations.total > 0 && (
      <section id="associations" class="p-assos">
        <h2 class="badge">Ce qui se crée en associations</h2>
        <Associations a={plus.associations} />
      </section>
    )}
    {droitLocal && (
      <section id="associations" class="p-assos">
        <h2 class="badge">Ce qui se crée en associations</h2>
        <p class="p-strate">
          Ici, le répertoire national ne sait rien. En Alsace-Moselle, une association ne se
          déclare pas en préfecture : elle s’inscrit au registre des associations tenu par le
          greffe du tribunal judiciaire, sous le code civil local. C’est là que se consulte ce
          qui s’est créé — et non dans le fichier dont le reste du pays relève.
        </p>
      </section>
    )}

    {(plus.presentes || plus.entreprises) && (
      <section id="entreprises" class="p-assos">
        <h2 class="badge">Ses entreprises</h2>
        {plus.presentes && <EntreprisesPresentes p={plus.presentes} />}
        {plus.entreprises && (
          <>
            <h3 class="p-titre-echelon">Ce qu’elles publient au BODACC</h3>
            <Entreprises e={plus.entreprises} nom={commune.nom} cp={commune.cp} />
          </>
        )}
      </section>
    )}

    {vie.travail && (
      <section id="travail">
        <h2 class="badge">Le travail sur place</h2>
        <Travail t={vie.travail} />
        <Demarches bloc="travail" />
      </section>
    )}

    {equ && (
      <section id="equipements" class="p-equipements">
        <h2 class="badge">Ce qu’on trouve sur place</h2>
        <Equipements e={equ} />
        <Demarches bloc="equipements" />
      </section>
