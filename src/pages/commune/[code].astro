      </section>
    )}

    {vie.investissement && (
      <section id="investissement">
        <h2 class="badge">Les projets que l’État a subventionnés</h2>
        <Investissement i={vie.investissement} />
      </section>
    )}

    {plus.centres && (
      <section id="ccas" class="p-finances p-echelons p-assos">
        <h2 class="badge">L’action sociale : le CCAS</h2>
