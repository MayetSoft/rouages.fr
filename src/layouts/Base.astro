---
import '../styles/global.css';
import RechercheCommune from '../composants/RechercheCommune.astro';

interface Props {
  titre: string;
  description: string;
  /** L'explorateur occupe tout l'écran ; les pages de nœud sont des pages. */
  plein?: boolean;
  /**
   * L'adresse d'un flux Atom que cette page accompagne.
   *
   * Déclarée dans l'en-tête plutôt que seulement dans le corps : c'est ainsi
   * qu'un navigateur et qu'un agrégateur le trouvent sans qu'on ait à coller
   * l'adresse à la main.
   */
  flux?: string;
  /**
   * La section du site : l'accueil, qui explique ; le fonctionnement — la
   * carte, les pouvoirs, le glossaire, la méthode et les fiches de nœud — ;
   * les données d'un territoire, de la commune à la région ; l'argent public,
   * ce que l'État dépense et d'où il le tient ; les jeux ; les simulateurs,
   * qui font un calcul sur les données publiques à partir de ce qu'on saisit.
   */
  section?: 'accueil' | 'fonctionnement' | 'chez-moi' | 'argent-public' | 'jeux' | 'simulateurs';
  /** Dans la section fonctionnement, la page courante du sous-menu. */
  sousPage?: 'carte' | 'pouvoirs' | 'glossaire' | 'methode';
  /**
   * Faux pour une page que les moteurs ne doivent pas indexer : le jeu des
   * prix, dont DVF interdit l'indexation (docs/07-risques.md).
   */
  indexer?: boolean;
  /**
   * L'image d'aperçu quand on partage l'adresse (`og:image`), 1 200 × 630,
   * dans `public/apercus/` (voir `scripts/apercus.mjs`). Celle du site par défaut.
   */
  image?: string;
}
const { titre, description, plein = false, flux, section, sousPage, indexer = true, image = '/apercus/rouages.png' } = Astro.props;
const imageAbsolue = new URL(image, Astro.site ?? 'https://rouages.fr').href;
const courant = (s: string) => (section === s ? 'page' : undefined);
const sousCourant = (s: string) => (sousPage === s ? 'page' : undefined);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre} — Rouages</title>
    <meta name="description" content={description} />
    {!indexer && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {flux && (
      <link rel="alternate" type="application/atom+xml" title={titre} href={flux} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/polices/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={section === 'fonctionnement' ? 'avec-sous-nav' : undefined}>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="bandeau">
      <div class="bandeau-int">
        <a class="marque" href="/"><svg class="marque-logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M13.01,3.97 L13.22,0.75 L18.78,0.75 L18.99,3.97 L22.40,5.38 L24.81,3.25 L28.75,7.19 L26.62,9.60 L28.03,13.01 L31.25,13.22 L31.25,18.78 L28.03,18.99 L26.62,22.40 L28.75,24.81 L24.81,28.75 L22.40,26.62 L18.99,28.03 L18.78,31.25 L13.22,31.25 L13.01,28.03 L9.60,26.62 L7.19,28.75 L3.25,24.81 L5.38,22.40 L3.97,18.99 L0.75,18.78 L0.75,13.22 L3.97,13.01 L5.38,9.60 L3.25,7.19 L7.19,3.25 L9.60,5.38Z M16,8.6 L24.2,15.6 L22.4,15.6 L22.4,23.2 L9.6,23.2 L9.6,15.6 L7.8,15.6Z"/><path d="M14.3,23.2 V19 H17.7 V23.2Z"/></svg>Rouages</a>
        <span class="baseline">qui fait quoi, et avec qui</span>
        <RechercheCommune />
        <nav aria-label="Le site">
          <a href="/" aria-current={courant('accueil')}>Accueil</a>
          <a href="/fonctionnement" aria-current={courant('fonctionnement')}>Fonctionnement des institutions</a>
          <a href="/chez-moi" aria-current={courant('chez-moi')}>Données de chez moi</a>
          <a href="/argent-public" aria-current={courant('argent-public')}>L’argent public</a>
          <a href="/jeux" aria-current={courant('jeux')}>Jeux</a>
          <a href="/simulateurs" aria-current={courant('simulateurs')}>Simulateurs</a>
        </nav>
      </div>
      {section === 'fonctionnement' && (
        <nav class="sous-nav" aria-label="Le fonctionnement">
          <a href="/fonctionnement" aria-current={sousCourant('carte')}>Le réseau</a>
          <a href="/etat" aria-current={sousCourant('pouvoirs')}>Les pouvoirs</a>
          <a href="/glossaire" aria-current={sousCourant('glossaire')}>Glossaire</a>
          <a href="/methode" aria-current={sousCourant('methode')}>La méthode</a>
        </nav>
      )}
    </header>

    <main id="contenu">
      <slot />
    </main>

    <a href="#contenu" class="haut-de-page" hidden>
      <span aria-hidden="true">↑</span>
      <span class="haut-de-page-texte">Haut de page</span>
    </a>
    <script>
      import '../client/haut-de-page.ts';
    </script>

    {!plein && (
      <footer>
        <p>
          Rouages ne réécrit pas ce que Wikipédia, Légifrance ou l’open data
          disent déjà&nbsp;: il montre les liens entre eux. Ce site n’est ni une
          source de droit, ni un conseil juridique.
        </p>
        <p>
          Contenu sous licence CC BY-SA 4.0, données publiques sous Licence
          Ouverte. Chaque nœud porte sa date de vérification.
          <a href="/mentions">Mentions légales</a>.
        </p>
        <p>
          Une erreur&nbsp;? <a href="/signaler">Signalez-la</a> — les référentiels
          ont des trous, et vous connaissez peut-être votre commune mieux qu’eux.
        </p>
      </footer>
    )}
  </body>
</html>
