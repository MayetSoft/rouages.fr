    "7zip-min": "^3.0.1",
    "axe-core": "4.10.2",
    "playwright": "1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
